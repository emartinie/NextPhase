{"book":"Nehemiah","chapter":2,"entries":[{"id":12308,"title":"Nehemiah 2:1","segments":["¶And it came to pass in the month Nisan, in the twentieth year of Artaxerxes the king, [that] wine [was] before him: and I took up the wine, and gave [it] unto the king. Now I had not been [beforetime] sad in his presence."],"ref":"Nehemiah 2:1","verse":1,"words":[{"text":"¶And it came to pass in the month","strong":"H2320"},{"text":" Nisan","strong":"H5212"},{"text":", in the twentieth","strong":"H6242"},{"text":" year","strong":"H8141"},{"text":" of Artaxerxes","strong":"H783"},{"text":" the king","strong":"H4428"},{"text":", [that] wine","strong":"H3196"},{"text":" [was] before","strong":"H6440"},{"text":" him: and I took up","strong":"H5375"},{"text":" the wine","strong":"H3196"},{"text":", and gave","strong":"H5414"},{"text":" [it] unto the king","strong":"H4428"},{"text":". Now I had not been [beforetime] sad","strong":"H7451"},{"text":" in his presence","strong":"H6440"},{"text":"."}]},{"id":12309,"title":"Nehemiah 2:2","segments":["Wherefore the king said unto me, Why [is] thy countenance sad, seeing thou [art] not sick? this [is] nothing [else] but sorrow of heart. Then I was very sore afraid,"],"ref":"Nehemiah 2:2","verse":2,"words":[{"text":"Wherefore the king","strong":"H4428"},{"text":" said","strong":"H559"},{"text":" unto me, Why [is] thy countenance","strong":"H6440"},{"text":" sad","strong":"H7451"},{"text":", seeing thou [art] not sick","strong":"H2470"},{"text":"? this [is] nothing [else] but sorrow","strong":"H7455"},{"text":" of heart","strong":"H3820"},{"text":". Then I was very","strong":"H3966"},{"text":" sore","strong":"H7235"},{"text":" afraid","strong":"H3372"},{"text":","}]},{"id":12310,"title":"Nehemiah 2:3","segments":["And said unto the king, Let the king live for ever: why should not my countenance be sad, when the city, the place of my fathers' sepulchres, [lieth] waste, and the gates thereof are consumed with fire?"],"ref":"Nehemiah 2:3","verse":3,"words":[{"text":"And said","strong":"H559"},{"text":" unto the king","strong":"H4428"},{"text":", Let the king","strong":"H4428"},{"text":" live","strong":"H2421"},{"text":" for ever","strong":"H5769"},{"text":": why should not my countenance","strong":"H6440"},{"text":" be sad","strong":"H3415"},{"text":", when the city","strong":"H5892"},{"text":", the place","strong":"H1004"},{"text":" of my fathers","strong":"H1"},{"text":"' sepulchres","strong":"H6913"},{"text":", [lieth] waste","strong":"H2720"},{"text":", and the gates","strong":"H8179"},{"text":" thereof are consumed","strong":"H398"},{"text":" with fire","strong":"H784"},{"text":"?"}]},{"id":12311,"title":"Nehemiah 2:4","segments":["Then the king said unto me, For what dost thou make request? So I prayed to the God of heaven."],"ref":"Nehemiah 2:4","verse":4,"words":[{"text":"Then the king","strong":"H4428"},{"text":" said","strong":"H559"},{"text":" unto me, For what dost thou make request","strong":"H1245"},{"text":"? So I prayed","strong":"H6419"},{"text":" to the God","strong":"H430"},{"text":" of heaven","strong":"H8064"},{"text":"."}]},{"id":12312,"title":"Nehemiah 2:5","segments":["And I said unto the king, If it please the king, and if thy servant have found favour in thy sight, that thou wouldest send me unto Judah, unto the city of my fathers' sepulchres, that I may build it."],"ref":"Nehemiah 2:5","verse":5,"words":[{"text":"And I said","strong":"H559"},{"text":" unto the king","strong":"H4428"},{"text":", If it please","strong":"H2895"},{"text":" the king","strong":"H4428"},{"text":", and if thy servant","strong":"H5650"},{"text":" have found favour","strong":"H3190"},{"text":" in thy sight","strong":"H6440"},{"text":", that thou wouldest send","strong":"H7971"},{"text":" me unto Judah","strong":"H3063"},{"text":", unto the city","strong":"H5892"},{"text":" of my fathers","strong":"H1"},{"text":"' sepulchres","strong":"H6913"},{"text":", that I may build","strong":"H1129"},{"text":" it."}]}