{"book":"Joshua","chapter":8,"entries":[{"id":6003,"title":"Joshua 8:1","segments":["¶And the LORD said unto Joshua, Fear not, neither be thou dismayed: take all the people of war with thee, and arise, go up to Ai: see, I have given into thy hand the king of Ai, and his people, and his city, and his land:"],"ref":"Joshua 8:1","verse":1,"words":[{"text":"¶And the LORD","strong":"H3068"},{"text":" said","strong":"H559"},{"text":" unto Joshua","strong":"H3091"},{"text":", Fear","strong":"H3372"},{"text":" not, neither be thou dismayed","strong":"H2865"},{"text":": take","strong":"H3947"},{"text":" all the people","strong":"H5971"},{"text":" of war","strong":"H4421"},{"text":" with thee, and arise","strong":"H6965"},{"text":", go up","strong":"H5927"},{"text":" to Ai","strong":"H5857"},{"text":": see","strong":"H7200"},{"text":", I have given","strong":"H5414"},{"text":" into thy hand","strong":"H3027"},{"text":" the king","strong":"H4428"},{"text":" of Ai","strong":"H5857"},{"text":", and his people","strong":"H5971"},{"text":", and his city","strong":"H5892"},{"text":", and his land","strong":"H776"},{"text":":"}]},{"id":6004,"title":"Joshua 8:2","segments":["And thou shalt do to Ai and her king as thou didst unto Jericho and her king: only the spoil thereof, and the cattle thereof, shall ye take for a prey unto yourselves: lay thee an ambush for the city behind it."],"ref":"Joshua 8:2","verse":2,"words":[{"text":"And thou shalt do","strong":"H6213"},{"text":" to Ai","strong":"H5857"},{"text":" and her king","strong":"H4428"},{"text":" as thou didst","strong":"H6213"},{"text":" unto Jericho","strong":"H3405"},{"text":" and her king","strong":"H4428"},{"text":": only the spoil","strong":"H7998"},{"text":" thereof, and the cattle","strong":"H929"},{"text":" thereof, shall ye take for a prey","strong":"H962"},{"text":" unto yourselves: lay","strong":"H7760"},{"text":" thee an ambush","strong":"H693"},{"text":" for the city","strong":"H5892"},{"text":" behind","strong":"H