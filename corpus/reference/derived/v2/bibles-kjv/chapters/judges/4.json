{"book":"Judges","chapter":4,"entries":[{"id":6600,"title":"Judges 4:1","segments":["¶And the children of Israel again did evil in the sight of the LORD, when Ehud was dead."],"ref":"Judges 4:1","verse":1,"words":[{"text":"¶And the children","strong":"H1121"},{"text":" of Israel","strong":"H3478"},{"text":" again","strong":"H3254"},{"text":" did","strong":"H6213"},{"text":" evil","strong":"H7451"},{"text":" in the sight","strong":"H5869"},{"text":" of the LORD","strong":"H3068"},{"text":", when Ehud","strong":"H164"},{"text":" was dead","strong":"H4191"},{"text":"."}]},{"id":6601,"title":"Judges 4:2","segments":["And the LORD sold them into the hand of Jabin king of Canaan, that reigned in Hazor; the captain of whose host [was] Sisera, which dwelt in Harosheth of the Gentiles."],"ref":"Judges 4:2","verse":2,"words":[{"text":"And the LORD","strong":"H3068"},{"text":" sold","strong":"H4376"},{"text":" them into the hand","strong":"H3027"},{"text":" of Jabin","strong":"H2985"},{"text":" king","strong":"H4428"},{"text":" of Canaan","strong":"H3667"},{"text":", that reigned","strong":"H4427"},{"text":" in Hazor","strong":"H2674"},{"text":"; the captain","strong":"H8269"},{"text":" of whose host","strong":"H6635"},{"text":" [was] Sisera","strong":"H5516"},{"text":", which dwelt","strong":"H3427"},{"text":" in Harosheth","strong":"H2800"},{"text":" of the Gentiles","strong":"H1471"},{"text":"."}]},{"id":6602,"title":"Judges 4:3","segments":["And the children of Israel cried unto the LORD: for he had nine hundred chariots of iron; and twenty years he mightily oppressed the children of Israel."],"ref":"Judges 4:3","verse":3,"words":[{"text":"And the children","strong":"H1121"},{"text":" of Israel","strong":"H3478"},{"text":" cried","strong":"H6817"},{"text":" unto the LORD","strong":"H3068"},{"text":": for he had nine","strong":"H8672"},{"text":" hundred","strong":"H3967"},{"text":" chariots","strong":"H7393"},{"text":" of iron","strong":"H1270"},{"text":"; and twenty","stro