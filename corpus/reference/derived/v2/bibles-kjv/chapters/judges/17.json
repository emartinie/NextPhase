":6991,"title":"Judges 17:11","segments":["And the Levite was content to dwell with the man; and the young man was unto him as one of his sons."],"ref":"Judges 17:11","verse":11,"words":[{"text":"And the Levite","strong":"H3881"},{"text":" was content","strong":"H2974"},{"text":" to dwell","strong":"H3427"},{"text":" with the man","strong":"H376"},{"text":"; and the young man","strong":"H5288"},{"text":" was unto him as one","strong":"H259"},{"text":" of his sons","strong":"H1121"},{"text":"."}]},{"id":6992,"title":"Judges 17:12","segments":["And Micah consecrated the Levite; and the young man became his priest, and was in the house of Micah."],"ref":"Judges 17:12","verse":12,"words":[{"text":"And Micah","strong":"H4318"},{"text":" consecrated","strong":"H4390"},{"text":"","strong":"H3027"},{"text":" the Levite","strong":"H3881"},{"text":"; and the young man","strong":"H5288"},{"text":" became his priest","strong":"H3548"},{"text":", and was in the house","strong":"H1004"},{"text":" of Micah","strong":"H4318"},{"text":"."}]},{"id":6993,"title":"Judges 17:13","segments":["Then said Micah, Now know I that the LORD will do me good, seeing I have a Levite to [my] priest."],"ref":"Judges 17:13","verse":13,"words":[{"text":"Then said","strong":"H559"},{"text":" Micah","strong":"H4318"},{"text":", Now know","strong":"H3045"},{"text":" I that the LORD","strong":"H3068"},{"text":" will do me good","strong":"H3190"},{"text":", seeing I have a Levite","strong":"H3881"},{"text":" to [my] priest","strong":"H3548"},{"text":"."}]}]}
