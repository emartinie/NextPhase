{"book":"Genesis","chapter":18,"entries":[{"id":425,"title":"Genesis 18:1","segments":["¶And the LORD appeared unto him in the plains of Mamre: and he sat in the tent door in the heat of the day; {plain: Heb. plains}"],"ref":"Genesis 18:1","verse":1,"words":[{"text":"¶And the LORD","strong":"H3068"},{"text":" appeared","strong":"H7200"},{"text":" unto him in the plains","strong":"H436"},{"text":" of Mamre","strong":"H4471"},{"text":": and he sat","strong":"H3427"},{"text":" in the tent","strong":"H168"},{"text":" door","strong":"H6607"},{"text":" in the heat","strong":"H2527"},{"text":" of the day","strong":"H3117"},{"text":"; {plain: Heb. plains}"}]},{"id":426,"title":"Genesis 18:2","segments":["And he lift up his eyes and looked, and, lo, three men stood by him: and when he saw [them], he ran to meet them from the tent door, and bowed himself toward the ground,"],"ref":"Genesis 18:2","verse":2,"words":[{"text":"And he lift up","strong":"H5375"},{"text":" his eyes","strong":"H5869"},{"text":" and looked","strong":"H7200"},{"text":", and, lo, three","strong":"H7969"},{"text":" men","strong":"H582"},{"text":" stood","strong":"H5324"},{"text":" by him: and when he saw","strong":"H7200"},{"text":" [them], he ran","strong":"H7323"},{"text":" to meet","strong":"H7125"},{"text":" them from the tent","strong":"H168"},{"text":" door","strong":"H6607"},{"text":", and bowed","strong":"H7812"},{"text":" himself toward the ground","strong":"H776"},{"text":","}]},{"id":427,"title":"Genesis 18:3","segments":["And said, My Lord, if now I have found favour in thy sight, pass not away, I pray thee, from thy servant:"],"ref":"Genesis 18:3","verse":3,"words":[{"text":"And said","strong":"H559"},{"text":", My Lord","strong":"H136"},{"text":", if now I have found","strong":"H4672"},{"text":" favour","strong":"H2580"},{"text":" in thy sight","strong":"H5869"},{"text":", pass not away","strong":"H5674"},{"text":", I pray thee, from thy servant","strong":"H5650"},{"text":":"}]},{"id":428,"