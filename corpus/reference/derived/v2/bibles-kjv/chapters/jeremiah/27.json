{"book":"Jeremiah","chapter":27,"entries":[{"id":19597,"title":"Jeremiah 27:1","segments":["¶In the beginning of the reign of Jehoiakim the son of Josiah king of Judah came this word unto Jeremiah from the LORD, saying,"],"ref":"Jeremiah 27:1","verse":1,"words":[{"text":"¶In the beginning","strong":"H7225"},{"text":" of the reign","strong":"H4467"},{"text":" of Jehoiakim","strong":"H3079"},{"text":" the son","strong":"H1121"},{"text":" of Josiah","strong":"H2977"},{"text":" king","strong":"H4428"},{"text":" of Judah","strong":"H3063"},{"text":" came this word","strong":"H1697"},{"text":" unto Jeremiah","strong":"H3414"},{"text":" from the LORD","strong":"H3068"},{"text":", saying","strong":"H559"},{"text":","}]},{"id":19598,"title":"Jeremiah 27:2","segments":["Thus saith the LORD to me; Make thee bonds and yokes, and put them upon thy neck, {saith...: or, hath the LORD said}"],"ref":"Jeremiah 27:2","verse":2,"words":[{"text":"Thus saith","strong":"H559"},{"text":" the LORD","strong":"H3068"},{"text":" to me; Make","strong":"H6213"},{"text":" thee bonds","strong":"H4147"},{"text":" and yokes","strong":"H4133"},{"text":", and put","strong":"H5414"},{"text":" them upon thy neck","strong":"H6677"},{"text":", {saith...: or, hath the LORD said}"}]},{"id":19599,"title":"Jeremiah 27:3","segments":["And send them to the king of Edom, and to the king of Moab, and to the king of the Ammonites, and to the king of Tyrus, and to the king of Zidon, by the hand of the messengers which come to Jerusalem unto Zedekiah king of Judah;"],"ref":"Jeremiah 27:3","verse":3,"words":[{"text":"And send","strong":"H7971"},{"text":" them to the king","strong":"H4428"},{"text":" of Edom","strong":"H123"},{"text":", and to the king","strong":"H4428"},{"text":" of Moab","strong":"H4124"},{"text":", and to the king","strong":"H4428"},{"text":" of the Ammonites","strong":"H1121"},{"text":"","strong":"H5983"},{"text":", and to the king","strong":"H4428"},{"text":" of Tyrus","strong":"H6865"},{"text":", and to the king","strong":"H4428"},{"text":" of Zidon","strong":"H6721"},{"text":", by the hand","strong":"H3027"},{"text":" of the messengers","strong":"H4397"},{"text":" which come","strong":"H935"},{"text":" to Jerusalem","strong":"H3389"},{"text":" unto Zedekiah","strong":"H6667"},{"text":" king","strong":"H4428"},{"text":" of Judah","strong":"H3063"},{"text":";"}]},{"id":19600,"title":"Jeremiah 27:4","segments":["And command them to say unto their masters, Thus saith the LORD of hosts, the God of Israel; Thus shall ye say unto your masters; {to say...: or, concerning their masters, saying}"],"ref":"Jeremiah 27:4","verse":4,"words":[{"text":"And command","strong":"H6680"},{"text":" them to say","strong":"H559"},{"text":" unto their masters","strong":"H113"},{"text":", Thus saith","strong":"H559"},{"text":" the LORD","strong":"H3068"},{"text":" of hosts","strong":"H6635"},{"text":", the God","strong":"H430"},{"text":" of Israel","strong":"H3478"},{"text":"; Thus shall ye say","strong":"H559"},{"text":" unto your masters","strong":"H113"},{"text":"; {to say...: or, concerning their masters, saying}"}]},{"id":19601,"title":"Jeremiah 27:5","segments":["I have made the earth, the man and the beast that [are] upon the ground, by my great power and by my outstretched arm, and have given it unto whom it seemed meet unto me."],"ref":"Jeremiah 27:5","verse":5,"words":[{"text":"I have made","strong":"H6213"},{"text":" the earth","strong":"H776"},{"text":", the man","strong":"H120"},{"text":" and the beast","strong":"H929"},{"text":" that [are] upon","strong":"H6440"},{"text":" the ground","strong":"H776"},{"text":", by my great","strong":"H1419"},{"text":" power","strong":"H3581"},{"text":" and by my outstretched","strong":"H5186"},{"text":" arm","strong":"H2220"},{"text":", and have given","strong":"H5414"},{"text":" it unto whom it seemed","strong":"H5869"},{"text":" meet","strong":"H3474"},{"text":" unto me."}]},{"id":19602,"title":"Jeremiah 27:6","segments":["And now have I given all these lands into the hand of Nebuchadnezzar the king of Babylon, my servant; and the beasts of the field have I given him also to serve him."],"ref":"Jeremiah 27:6","verse":6,"words":[{"text":"And now have I given","strong":"H5414"},{"text":" all these lands","strong":"H776"},{"text":" into the hand","strong":"H3027"},{"text":" of Nebuchadnezzar","strong":"H5019"},{"text":" the king","strong":"H4428"},{"text":" of Babylon","strong":"H894"},{"text":", my servant","strong":"H5650"},{"text":"; and the beasts","strong":"H2416"},{"text":" of the field","strong":"H7704"},{"text":" have I given","strong":"H5414"},{"text":" him also to serve","strong":"H5647"},{"text":" him."}]},{"id":19603,"title":"Jeremiah 27:7","segments":["And all nations shall serve him, and his son, and his son's son, until the very time of his land come: and then many nations and great kings shall serve themselves of him."],"ref":"Jeremiah 27:7","verse":7,"words":[{"text":"And all nations","strong":"H1471"},{"text":" shall serve","strong":"H5647"},{"text":" him, and his son","strong":"H1121"},{"text":", and his son's","strong":"H1121"},{"text":" son","strong":"H1121"},{"text":", until the very time","strong":"H6256"},{"text":" of his land","strong":"H776"},{"text":" come","strong":"H935"},{"text":": and then many","strong":"H7227"},{"text":" nations","strong":"H1471"},{"text":" and great","strong":"H1419"},{"text":" kings","strong":"H4428"},{"text":" shall serve","strong":"H5647"},{"text":" themselves of him."}]},{"id":19604,"title":"Jeremiah 27:8","segments":["And it shall come to pass, [that] the nation and kingdom which will not serve the same Nebuchadnezzar the king of Babylon, and that will not put their neck under the yoke of the king of Babylon, that nation will I punish, saith the LORD, with the sword, and with the famine, and with the pestilence, until I have consumed them by his hand."],"ref":"Jeremiah 27:8","verse":8,"words":[{"text":"And it shall come to pass, [that] the nation","strong":"H1471"},{"text":" and kingdom","strong":"H4467"},{"text":" which will not serve","strong":"H5647"},{"text":" the same Nebuchadnezzar","strong":"H5019"},{"text":" the king","strong":"H4428"},{"text":" of Babylon","strong":"H894"},{"text":", and that will not put","strong":"H5414"},{"text":" their neck","strong":"H6677"},{"text":" under the yoke","strong":"H5923"},{"text":" of the king","strong":"H4428"},{"text":" of Babylon","strong":"H894"},{"text":", that nation","strong":"H1471"},{"text":" will I punish","strong":"H6485"},{"text":", saith","strong":"H5002"},{"text":" the LORD","strong":"H3068"},{"text":", with the sword","strong":"H2719"},{"text":", and with the famine","strong":"H7458"},{"text":", and with the pestilence","strong":"H1698"},{"text":", until I have consumed","strong":"H8552"},{"text":" them by his hand","strong":"H3027"},{"text":"."}]},{"id":19605,"title":"Jeremiah 27:9","segments":["Therefore hearken not ye to your prophets, nor to your diviners, nor to your dreamers, nor to your enchanters, nor to your sorcerers, which speak unto you, saying, Ye shall not serve the king of Babylon: {dreamers: Heb. dreams}"],"ref":"Jeremiah 27:9","verse":9,"words":[{"text":"Therefore hearken","strong":"H8085"},{"text":" not ye to your prophets","strong":"H5030"},{"text":", nor to your diviners","strong":"H7080"},{"text":", nor to your dreamers","strong":"H2472"},{"text":", nor to your enchanters","strong":"H6049"},{"text":", nor to your sorcerers","strong":"H3786"},{"text":", which speak","strong":"H559"},{"text":" unto you, saying","strong":"H559"},{"text":", Ye shall not serve","strong":"H5647"},{"text":" the king","strong":"H4428"},{"text":" of Babylon","strong":"H894"},{"text":": {dreamers: Heb. dreams}"}]},{"id":19606,"title":"Jeremiah 27:10","segments":["For they prophesy a lie unto you, to remove you far from your land; and that I should drive you out, and ye should perish."],"ref":"Jeremiah 27:10","verse":10,"words":[{"text":"For they prophesy","strong":"H5012"},{"text":" a lie","strong":"H8267"},{"text":" unto you, to remove you far","strong":"H7368"},{"text":" from your land","strong":"H127"},{"text":"; and that I should drive you out","strong":"H5080"},{"text":", and ye should perish","strong":"H6"},{"text":"."}]},{"id":19607,"title":"Jeremiah 27:11","segments":["But the nations that bring their neck under the yoke of the king of Babylon, and serve him, those will I let remain still in their own land, saith the LORD; and they shall till it, and dwell therein."],"ref":"Jeremiah 27:11","verse":11,"words":[{"text":"But the nations","strong":"H1471"},{"text":" that bring","strong":"H935"},{"text":" their neck","strong":"H6677"},{"text":" under the yoke","strong":"H5923"},{"text":" of the king","strong":"H4428"},{"text":" of Babylon","strong":"H894"},{"text":", and serve","strong":"H5647"},{"text":" him, those will I let remain still","strong":"H3240"},{"text":" in their own land","strong":"H127"},{"text":", saith","strong":"H5002"},{"text":" the LORD","strong":"H3068"},{"text":"; and they shall till","strong":"H5647"},{"text":" it, and dwell","strong":"H3427"},{"text":" therein."}]},{"id":19608,"title":"Jeremiah 27:12","segments":["¶I spake also to Zedekiah king of Judah according to all these words, saying, Bring your necks under the yoke of the king of Babylon, and serve him and his people, and live."],"ref":"Jeremiah 27:12","verse":12,"words":[{"text":"¶I spake","strong":"H1696"},{"text":" also to Zedekiah","strong":"H6667"},{"text":" king","strong":"H4428"},{"text":" of Judah","strong":"H3063"},{"text":" according to all these words","strong":"H1697"},{"text":", saying","strong":"H559"},{"text":", Bring","strong":"H935"},{"text":" your necks","strong":"H6677"},{"text":" under the yoke","strong":"H5923"},{"text":" of the king","strong":"H4428"},{"text":" of Babylon","strong":"H894"},{"text":", and serve","strong":"H5647"},{"text":" him and his people","strong":"H5971"},{"text":", and live","strong":"H2421"},{"text":"."}]},{"id":19609,"title":"Jeremiah 27:13","segments":["Why will ye die, thou and thy people, by the sword, by the famine, and by the pestilence, as the LORD hath spoken against the nation that will not serve the king of Babylon?"],"ref":"Jeremiah 27:13","verse":13,"words":[{"text":"Why will ye die","strong":"H4191"},{"text":", thou and thy people","strong":"H5971"},{"text":", by the sword","strong":"H2719"},{"text":", by the famine","strong":"H7458"},{"text":", and by the pestilence","strong":"H1698"},{"text":", as the LORD","strong":"H3068"},{"text":" hath spoken","strong":"H1696"},{"text":" against the nation","strong":"H1471"},{"text":" that will not serve","strong":"H5647"},{"text":" the king","strong":"H4428"},{"text":" of Babylon","strong":"H894"},{"text":"?"}]},{"id":19610,"title":"Jeremiah 27:14","segments":["Therefore hearken not unto the words of the prophets that speak unto you, saying, Ye shall not serve the king of Babylon: for they prophesy a lie unto you."],"ref":"Jeremiah 27:14","verse":14,"words":[{"text":"Therefore hearken","strong":"H8085"},{"text":" not unto the words","strong":"H1697"},{"text":" of the prophets","strong":"H5030"},{"text":" that speak","strong":"H559"},{"text":" unto you, saying","strong":"H559"},{"text":", Ye shall not serve","strong":"H5647"},{"text":" the king","strong":"H4428"},{"text":" of Babylon","strong":"H894"},{"text":": for they prophesy","strong":"H5012"},{"text":" a lie","strong":"H8267"},{"text":" unto you."}]},{"id":19611,"title":"Jeremiah 27:15","segments":["For I have not sent them, saith the LORD, yet they prophesy a lie in my name; that I might drive you out, and that ye might perish, ye, and the prophets that prophesy unto you. {a lie: Heb. in a lie, or, lyingly}"],"ref":"Jeremiah 27:15","verse":15,"words":[{"text":"For I have not sent","strong":"H7971"},{"text":" them, saith","strong":"H5002"},{"text":" the LORD","strong":"H3068"},{"text":", yet they prophesy","strong":"H5012"},{"text":"