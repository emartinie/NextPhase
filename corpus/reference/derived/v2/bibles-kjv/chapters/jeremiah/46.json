138"},{"text":", from","strong":"H6440"},{"text":" the oppressing","strong":"H3238"},{"text":" sword","strong":"H2719"},{"text":". {made...: Heb. multiplied the faller}"}]},{"id":20062,"title":"Jeremiah 46:17","segments":["They did cry there, Pharaoh king of Egypt [is but] a noise; he hath passed the time appointed."],"ref":"Jeremiah 46:17","verse":17,"words":[{"text":"They did cry","strong":"H7121"},{"text":" there, Pharaoh","strong":"H6547"},{"text":" king","strong":"H4428"},{"text":" of Egypt","strong":"H4714"},{"text":" [is but] a noise","strong":"H7588"},{"text":"; he hath passed","strong":"H5674"},{"text":" the time appointed","strong":"H4150"},{"text":"."}]},{"id":20063,"title":"Jeremiah 46:18","segments":["[As] I live, saith the King, whose name [is] the LORD of hosts, Surely as Tabor [is] among the mountains, and as Carmel by the sea, [so] shall he come."],"ref":"Jeremiah 46:18","verse":18,"words":[{"text":"[As] I live","strong":"H2416"},{"text":", saith","strong":"H5002"},{"text":" the King","strong":"H4428"},{"text":", whose name","strong":"H8034"},{"text":" [is] the LORD","strong":"H3068"},{"text":" of hosts","strong":"H6635"},{"text":", Surely as Tabor","strong":"H8396"},{"text":" [is] among the mountains","strong":"H2022"},{"text":", and as Carmel","strong":"H3760"},{"text":" by the sea","strong":"H3220"},{"text":", [so] shall he come","strong":"H935"},{"text":"."}]},{"id":20064,"title":"Jeremiah 46:19","segments":["O thou daughter dwelling in Egypt, furnish thyself to go into captivity: for Noph shall be waste and desolate without an inhabitant. {furnish...: Heb. make thee instruments of captivity}"],"ref":"Jeremiah 46:19","verse":19,"words":[{"text":"O thou daughter","strong":"H1323"},{"text":" dwelling","strong":"H3427"},{"text":" in Egypt","strong":"H4714"},{"text":", furnish","strong":"H6213"},{"text":" thyself to go into captivity","strong":"H3627"},{"text":"","strong":"H1473"},{"text":": for Noph","strong":"H5297"},{"text":" shall be waste","str