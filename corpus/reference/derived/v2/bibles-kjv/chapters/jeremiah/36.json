{"book":"Jeremiah","chapter":36,"entries":[{"id":19843,"title":"Jeremiah 36:1","segments":["¶And it came to pass in the fourth year of Jehoiakim the son of Josiah king of Judah, [that] this word came unto Jeremiah from the LORD, saying,"],"ref":"Jeremiah 36:1","verse":1,"words":[{"text":"¶And it came to pass in the fourth","strong":"H7243"},{"text":" year","strong":"H8141"},{"text":" of Jehoiakim","strong":"H3079"},{"text":" the son","strong":"H1121"},{"text":" of Josiah","strong":"H2977"},{"text":" king","strong":"H4428"},{"text":" of Judah","strong":"H3063"},{"text":", [that] this word","strong":"H1697"},{"text":" came unto Jeremiah","strong":"H3414"},{"text":" from the LORD","strong":"H3068"},{"text":", saying","strong":"H559"},{"text":","}]},{"id":19844,"title":"Jeremiah 36:2","segments":["Take thee a roll of a book, and write therein all the words that I have spoken unto thee against Israel, and against Judah, and against all the nations, from the day I spake unto thee, from the days of Josiah, even unto this day."],"ref":"Jeremiah 36:2","verse":2,"words":[{"text":"Take","strong":"H3947"},{"text":" thee a roll","strong":"H4039"},{"text":" of a book","strong":"H5612"},{"text":", and write","strong":"H3789"},{"text":" therein all the words","strong":"H1697"},{"text":" that I have spoken","strong":"H1696"},{"text":" unto thee against Israel","strong":"H3478"},{"text":", and against Judah","strong":"H3063"},{"text":", and against all the nations","strong":"H1471"},{"text":", from the day","strong":"H3117"},{"text":" I spake","strong":"H1696"},{"text":" unto thee, from the days","strong":"H3117"},{"text":" of Josiah","strong":"H2977"},{"text":", even unto this day","strong":"H3117"},{"text":"."}]},{"id":19845,"title":"Jeremiah 36:3","segments":["It may be that the house of Judah will hear all the evil which I purpose to do unto them; that they may return every man from his evil way; that I may forgive their iniquity and their sin."],"ref":"Jeremiah 36:3","verse":3,"