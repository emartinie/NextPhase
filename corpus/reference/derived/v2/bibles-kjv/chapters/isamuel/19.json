{"book":"I Samuel","chapter":19,"entries":[{"id":7707,"title":"I Samuel 19:1","segments":["¶And Saul spake to Jonathan his son, and to all his servants, that they should kill David."],"ref":"I Samuel 19:1","verse":1,"words":[{"text":"¶And Saul","strong":"H7586"},{"text":" spake","strong":"H1696"},{"text":" to Jonathan","strong":"H3129"},{"text":" his son","strong":"H1121"},{"text":", and to all his servants","strong":"H5650"},{"text":", that they should kill","strong":"H4191"},{"text":" David","strong":"H1732"},{"text":"."}]},{"id":7708,"title":"I Samuel 19:2","segments":["But Jonathan Saul's son delighted much in David: and Jonathan told David, saying, Saul my father seeketh to kill thee: now therefore, I pray thee, take heed to thyself until the morning, and abide in a secret [place], and hide thyself:"],"ref":"I Samuel 19:2","verse":2,"words":[{"text":"But Jonathan","strong":"H3083"},{"text":" Saul's","strong":"H7586"},{"text":" son","strong":"H1121"},{"text":" delighted","strong":"H2654"},{"text":" much","strong":"H3966"},{"text":" in David","strong":"H1732"},{"text":": and Jonathan","strong":"H3083"},{"text":" told","strong":"H5046"},{"text":" David","strong":"H1732"},{"text":", saying","strong":"H559"},{"text":", Saul","strong":"H7586"},{"text":" my father","strong":"H1"},{"text":" seeketh","strong":"H1245"},{"text":" to kill","strong":"H4191"},{"text":" thee: now therefore, I pray thee, take heed","strong":"H8104"},{"text":" to thyself until the morning","strong":"H1242"},{"text":", and abide","strong":"H3427"},{"text":" in a secret","strong":"H5643"},{"text":" [place], and hide","strong":"H2244"},{"text":" thyself:"}]},{"id":7709,"title":"I Samuel 19:3","segments":["And I will go out and stand beside my father in the field where thou [art], and I will commune with my father of thee; and what I see, that I will tell thee."],"ref":"I Samuel 19:3","verse":3,"words":[{"text":"And I will go out","strong":"H3318"},{"text":" and stand","strong":"H5975"},{"text":" b