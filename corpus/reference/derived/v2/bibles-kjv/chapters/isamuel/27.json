559"},{"text":", He hath made his people","strong":"H5971"},{"text":" Israel","strong":"H3478"},{"text":" utterly","strong":"H887"},{"text":" to abhor","strong":"H887"},{"text":" him; therefore he shall be my servant","strong":"H5650"},{"text":" for ever","strong":"H5769"},{"text":". {utterly...: Heb. to stink}"}]}]}
