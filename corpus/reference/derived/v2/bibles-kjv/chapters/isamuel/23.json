":"I Samuel 23:6","verse":6,"words":[{"text":"And it came to pass, when Abiathar","strong":"H54"},{"text":" the son","strong":"H1121"},{"text":" of Ahimelech","strong":"H288"},{"text":" fled","strong":"H1272"},{"text":" to David","strong":"H1732"},{"text":" to Keilah","strong":"H7084"},{"text":", [that] he came down","strong":"H3381"},{"text":" [with] an ephod","strong":"H646"},{"text":" in his hand","strong":"H3027"},{"text":"."}]},{"id":7817,"title":"I Samuel 23:7","segments":["¶And it was told Saul that David was come to Keilah. And Saul said, God hath delivered him into mine hand; for he is shut in, by entering into a town that hath gates and bars."],"ref":"I Samuel 23:7","verse":7,"words":[{"text":"¶And it was told","strong":"H5046"},{"text":" Saul","strong":"H7586"},{"text":" that David","strong":"H1732"},{"text":" was come","strong":"H935"},{"text":" to Keilah","strong":"H7084"},{"text":". And Saul","strong":"H7586"},{"text":" said","strong":"H559"},{"text":", God","strong":"H430"},{"text":" hath delivered","strong":"H5234"},{"text":" him into mine hand","strong":"H3027"},{"text":"; for he is shut in","strong":"H5462"},{"text":", by entering","strong":"H935"},{"text":" into a town","strong":"H5892"},{"text":" that hath gates","strong":"H1817"},{"text":" and bars","strong":"H1280"},{"text":"."}]},{"id":7818,"title":"I Samuel 23:8","segments":["And Saul called all the people together to war, to go down to Keilah, to besiege David and his men."],"ref":"I Samuel 23:8","verse":8,"words":[{"text":"And Saul","strong":"H7586"},{"text":" called","strong":"H8085"},{"text":" all the people","strong":"H5971"},{"text":" together","strong":"H8085"},{"text":" to war","strong":"H4421"},{"text":", to go down","strong":"H3381"},{"text":" to Keilah","strong":"H7084"},{"text":", to besiege","strong":"H6696"},{"text":" David","strong":"H1732"},{"text":" and his men","strong":"H582"},{"text":"."}]},{"id":7819,"title":"I Samuel 23:9","segments":["And David knew that Saul secretly practised mischief against him; and he said to Abiathar the priest, Bring hither the ephod."],"ref":"I Samuel 23:9","verse":9,"words":[{"text":"And David","strong":"H1732"},{"text":" knew","strong":"H3045"},{"text":" that Saul","strong":"H7586"},{"text":" secretly practised","strong":"H2790"},{"text":" mischief","strong":"H7451"},{"text":" against him; and he said","strong":"H559"},{"text":" to Abiathar","strong":"H54"},{"text":" the priest","strong":"H3548"},{"text":", Bring hither","strong":"H5066"},{"text":" the ephod","strong":"H646"},{"text":"."}]},{"id":7820,"title":"I Samuel 23:10","segments":["Then said David, O LORD God of Israel, thy servant hath certainly heard that Saul seeketh to come to Keilah, to destroy the city for my sake."],"ref":"I Samuel 23:10","verse":10,"words":[{"text":"Then said","strong":"H559"},{"text":" David","strong":"H1732"},{"text":", O LORD","strong":"H3068"},{"text":" God","strong":"H430"},{"text":" of Israel","strong":"H3478"},{"text":", thy servant","strong":"H5650"},{"text":" hath certainly","strong":"H8085"},{"text":" heard","strong":"H8085"},{"text":" that Saul","strong":"H7586"},{"text":" seeketh","strong":"H1245"},{"text":" to come","strong":"H935"},{"text":" to Keilah","strong":"H7084"},{"text":", to destroy","strong":"H7843"},{"text":" the city","strong":"H5892"},{"text":" for my sake."}]},{"id":7821,"title":"I Samuel 23:11","segments":["Will the men of Keilah deliver me up into his hand? will Saul come down, as thy servant hath heard? O LORD God of Israel, I beseech thee, tell thy servant. And the LORD said, He will come down."],"ref":"I Samuel 23:11","verse":11,"words":[{"text":"Will the men","strong":"H1167"},{"text":" of Keilah","strong":"H7084"},{"text":" deliver me up","strong":"H5462"},{"text":" into his hand","strong":"H3027"},{"text":"? will Saul","strong":"H7586"},{"text":" come down","strong":"H3381"},{"text":", as thy servant","strong":"H5650"},{"text":" hath heard","strong":"H8085"},{"text":"? O LORD","strong":"