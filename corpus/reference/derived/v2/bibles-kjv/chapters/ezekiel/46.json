{"book":"Ezekiel","chapter":46,"entries":[{"id":21656,"title":"Ezekiel 46:1","segments":["¶Thus saith the Lord GOD; The gate of the inner court that looketh toward the east shall be shut the six working days; but on the sabbath it shall be opened, and in the day of the new moon it shall be opened."],"ref":"Ezekiel 46:1","verse":1,"words":[{"text":"¶Thus saith","strong":"H559"},{"text":" the Lord","strong":"H136"},{"text":" GOD","strong":"H3069"},{"text":"; The gate","strong":"H8179"},{"text":" of the inner","strong":"H6442"},{"text":" court","strong":"H2691"},{"text":" that looketh","strong":"H6437"},{"text":" toward the east","strong":"H6921"},{"text":" shall be shut","strong":"H5462"},{"text":" the six","strong":"H8337"},{"text":" working","strong":"H4639"},{"text":" days","strong":"H3117"},{"text":"; but on the sabbath","strong":"H7676"},{"text":"","strong":"H3117"},{"text":" it shall be opened","strong":"H6605"},{"text":", and in the day","strong":"H3117"},{"text":" of the new moon","strong":"H2320"},{"text":" it shall be opened","strong":"H6605"},{"text":"."}]},{"id":21657,"title":"Ezekiel 46:2","segments":["And the prince shall enter by the way of the porch of [that] gate without, and shall stand by the post of the gate, and the priests shall prepare his burnt offering and his peace offerings, and he shall worship at the threshold of the gate: then he shall go forth; but the gate shall not be shut until the evening."],"ref":"Ezekiel 46:2","verse":2,"words":[{"text":"And the prince","strong":"H5387"},{"text":" shall enter","strong":"H935"},{"text":" by the way","strong":"H1870"},{"text":" of the porch","strong":"H197"},{"text":" of [that] gate","strong":"H8179"},{"text":" without","strong":"H2351"},{"text":", and shall stand","strong":"H5975"},{"text":" by the post","strong":"H4201"},{"text":" of the gate","strong":"H8179"},{"text":", and the priests","strong":"H3548"},{"text":" shall prepare","strong":"H6213"},{"text":" his burnt offering","strong":"H5930"},{"text":" and his peace offerings","strong":"H8002"},{"text":", and he shall worship","strong":"H7812"},{"text":" at the threshold","strong":"H4670"},{"text":" of the gate","strong":"H8179"},{"text":": then he shall go forth","strong":"H3318"},{"text":"; but the gate","strong":"H8179"},{"text":" shall not be shut","strong":"H5462"},{"text":" until the evening","strong":"H6153"},{"text":"."}]},{"id":21658,"title":"Ezekiel 46:3","segments":["Likewise the people of the land shall worship at the door of this gate before the LORD in the sabbaths and in the new moons."],"ref":"Ezekiel 46:3","verse":3,"words":[{"text":"Likewise the people","strong":"H5971"},{"text":" of the land","strong":"H776"},{"text":" shall worship","strong":"H7812"},{"text":" at the door","strong":"H6607"},{"text":" of this gate","strong":"H8179"},{"text":" before","strong":"H6440"},{"text":" the LORD","strong":"H3068"},{"text":" in the sabbaths","strong":"H7676"},{"text":" and in the new moons","strong":"H2320"},{"text":"."}]},{"id":21659,"title":"Ezekiel 46:4","segments":["And the burnt offering that the prince shall offer unto the LORD in the sabbath day [shall be] six lambs without blemish, and a ram without blemish."],"ref":"Ezekiel 46:4","verse":4,"words":[{"text":"And the burnt offering","strong":"H5930"},{"text":" that the prince","strong":"H5387"},{"text":" shall offer","strong":"H7126"},{"text":" unto the LORD","strong":"H3068"},{"text":" in the sabbath","strong":"H7676"},{"text":" day","strong":"H3117"},{"text":" [shall be] six","strong":"H8337"},{"text":" lambs","strong":"H3532"},{"text":" without blemish","strong":"H8549"},{"text":", and a ram","strong":"H352"},{"text":" without blemish","strong":"H8549"},{"text":"."}]},{"id":21660,"title":"Ezekiel 46:5","segments":["And the meat offering [shall be] an ephah for a ram, and the meat offering for the lambs as he shall be able to give, and an hin of oil to an ephah. {as he...: Heb. the gift of his hand}"],"ref":"Ezekiel 46:5","verse":5,"words":[{"text":"And the meat offering","strong":"H4503"},{"text":" [shall be] an ephah","strong":"H374"},{"text":" for a ram","strong":"H352"},{"text":", and the meat offering","strong":"H4503"},{"text":" for the lambs","strong":"H3532"},{"text":" as he shall be able","strong":"H3027"},{"text":" to give","strong":"H4991"},{"text":", and an hin","strong":"H1969"},{"text":" of oil","strong":"H8081"},{"text":" to an ephah","strong":"H374"},{"text":". {as he...: Heb. the gift of his hand}"}]},{"id":21661,"title":"Ezekiel 46:6","segments":["And in the day of the new moon [it shall be] a young bullock without blemish, and six lambs, and a ram: they shall be without blemish."],"ref":"Ezekiel 46:6","verse":6,"words":[{"text":"And in the day","strong":"H3117"},{"text":" of the new moon","strong":"H2320"},{"text":" [it shall be] a young","strong":"H1121"},{"text":"","strong":"H1241"},{"text":" bullock","strong":"H6499"},{"text":" without blemish","strong":"H8549"},{"text":", and six","strong":"H8337"},{"text":" lambs","strong":"H3532"},{"text":", and a ram","strong":"H352"},{"text":": they shall be without blemish","strong":"H8549"},{"text":"."}]},{"id":21662,"title":"Ezekiel 46:7","segments":["And he shall prepare a meat offering, an ephah for a bullock, and an ephah for a ram, and for the lambs according as his hand shall attain unto, and an hin of oil to an ephah."],"ref":"Ezekiel 46:7","verse":7,"words":[{"text":"And he shall prepare","strong":"H6213"},{"text":" a meat offering","strong":"H4503"},{"text":", an ephah","strong":"H374"},{"text":" for a bullock","strong":"H6499"},{"text":", and an ephah","strong":"H374"},{"text":" for a ram","strong":"H352"},{"text":", and for the lambs","strong":"H3532"},{"text":" according as his hand","strong":"H3027"},{"text":" shall attain","strong":"H5381"},{"text":" unto, and an hin","strong":"H1969"},{"text":" of oil","strong":"H8081"},{"text":" to an ephah","strong":"H374"},{"text":"."}]},{"id":21663,"title":"Ezekiel 46:8","segments":["And when the prince shall enter, he shall go in by the way of the porch of [that] gate, and he shall go forth by the way thereof."],"ref":"Ezekiel 46:8","verse":8,"words":[{"text":"And when the prince","strong":"H5387"},{"text":" shall enter","strong":"H935"},{"text":", he shall go","strong":"H935"},{"text":" in by the way","strong":"H1870"},{"text":" of the porch","strong":"H197"},{"text":" of [that] gate","strong":"H8179"},{"text":", and he shall go forth","strong":"H3318"},{"text":" by the way","strong":"H1870"},{"text":" thereof."}]},{"id":21664,"title":"Ezekiel 46:9","segments":["But when the people of the land shall come before the LORD in the solemn feasts, he that entereth in by the way of the north gate to worship shall go out by the way of the south gate; and he that entereth by the way of the south gate shall go forth by the way of the north gate: he shall not return by the way of the gate whereby he came in, but shall go forth over against it."],"ref":"Ezekiel 46:9","verse":9,"words":[{"text":"But when the people","strong":"H5971"},{"text":" of the land","strong":"H776"},{"text":" shall come","strong":"H935"},{"text":" before","strong":"H6440"},{"text":" the LORD","strong":"H3068"},{"text":" in the solemn feasts","strong":"H4150"},{"text":", he that entereth","strong":"H935"},{"text":" in by the way","strong":"H1870"},{"text":" of the north","strong":"H6828"},{"text":" gate","strong":"H8179"},{"text":" to worship","strong":"H7812"},{"text":" shall go out","strong":"H3318"},{"text":" by the way","strong":"H1870"},{"text":" of the south","strong":"H5045"},{"text":" gate","strong":"H8179"},{"text":"; and he that entereth","strong":"H935"},{"text":" by the way","strong":"H1870"},{"text":" of the south","strong":"H5045"},{"text":" gate","strong":"H8179"},{"text":" shall go forth","strong":"H3318"},{"text":" by the way","strong":"H1870"},{"text":" of the north","strong":"H6828"},{"text":" gate","strong":"H8179"},{"text":": he shall not return","strong":"H7725"}