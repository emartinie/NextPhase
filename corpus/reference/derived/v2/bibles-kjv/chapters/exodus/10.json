{"book":"Exodus","chapter":10,"entries":[{"id":1778,"title":"Exodus 10:1","segments":["¶And the LORD said unto Moses, Go in unto Pharaoh: for I have hardened his heart, and the heart of his servants, that I might shew these my signs before him:"],"ref":"Exodus 10:1","verse":1,"words":[{"text":"¶And the LORD","strong":"H3068"},{"text":" said","strong":"H559"},{"text":" unto Moses","strong":"H4872"},{"text":", Go","strong":"H935"},{"text":" in unto Pharaoh","strong":"H6547"},{"text":": for I have hardened","strong":"H3513"},{"text":" his heart","strong":"H3820"},{"text":", and the heart","strong":"H3820"},{"text":" of his servants","strong":"H5650"},{"text":", that I might shew","strong":"H7896"},{"text":" these my signs","strong":"H226"},{"text":" before","strong":"H7130"},{"text":" him:"}]},{"id":1779,"title":"Exodus 10:2","segments":["And that thou mayest tell in the ears of thy son, and of thy son's son, what things I have wrought in Egypt, and my signs which I have done among them; that ye may know how that I [am] the LORD."],"ref":"Exodus 10:2","verse":2,"words":[{"text":"And that thou mayest tell","strong":"H5608"},{"text":" in the ears","strong":"H241"},{"text":" of thy son","strong":"H1121"},{"text":", and of thy son's","strong":"H1121"},{"text":" son","strong":"H1121"},{"text":", what things I have wrought","strong":"H5953"},{"text":" in Egypt","strong":"H4714"},{"text":", and my signs","strong":"H226"},{"text":" which I have done","strong":"H7760"},{"text":" among them; that ye may know","strong":"H3045"},{"text":" how that I [am] the LORD","strong":"H3068"},{"text":"."}]},{"id":1780,"title":"Exodus 10:3","segments":["And Moses and Aaron came in unto Pharaoh, and said unto him, Thus saith the LORD God of the Hebrews, How long wilt thou refuse to humble thyself before me? let my people go, that they may serve me."],"ref":"Exodus 10:3","verse":3,"words":[{"text":"And Moses","strong":"H4872"},{"text":" and Aaron","strong":"H175"},{"text":" came in","strong":"H935"},{"text":" unto Pharaoh","strong":"H6547"},{"text":", and said","strong":"H559"},{"text":" unto him, Thus saith","strong":"H559"},{"text":" the LORD","strong":"H3068"},{"text":" God","strong":"H430"},{"text":" of the Hebrews","strong":"H5680"},{"text":", How long","strong":"H4970"},{"text":" wilt thou refuse","strong":"H3985"},{"text":" to humble","strong":"H6031"},{"text":" thyself before","strong":"H6440"},{"text":" me? let my people","strong":"H5971"},{"text":" go","strong":"H7971"},{"text":", that they may serve","strong":"H5647"},{"text":" me."}]},{"id":1781,"title":"Exodus 10:4","segments":["Else, if thou refuse to let my people go, behold, to morrow will I bring the locusts into thy coast:"],"ref":"Exodus 10:4","verse":4,"words":[{"text":"Else","strong":"H3588"},{"text":", if thou refuse","strong":"H3986"},{"text":" to let my people","strong":"H5971"},{"text":" go","strong":"H7971"},{"text":", behold, to morrow","strong":"H4279"},{"text":" will I bring","strong":"H935"},{"text":" the locusts","strong":"H697"},{"text":" into thy coast","strong":"H1366"},{"text":":"}]},{"id":1782,"title":"Exodus 10:5","segments":["And they shall cover the face of the earth, that one cannot be able to see the earth: and they shall eat the residue of that which is escaped, which remaineth unto you from the hail, and shall eat every tree which groweth for you out of the field: {face: Heb. eye}"],"ref":"Exodus 10:5","verse":5,"words":[{"text":"And they shall cover","strong":"H3680"},{"text":" the face","strong":"H5869"},{"text":" of the earth","strong":"H776"},{"text":", that one cannot be able","strong":"H3201"},{"text":" to see","strong":"H7200"},{"text":" the earth","strong":"H776"},{"text":": and they shall eat","strong":"H398"},{"text":" the residue","strong":"H3499"},{"text":" of that which is escaped","strong":"H6413"},{"text":", which remaineth","strong":"H7604"},{"text":" unto you from the hail","strong":"H1259"},{"text":", and shall eat","strong":"H398"},{"text":" every tree","strong":"H6086"},{"text":" which groweth","strong":"H6779"},{"text":" for you out of the field","strong":"H7704"},{"text":": {face: Heb. eye}"}]},{"id":1783,"title":"Exodus 10:6","segments":["And they shall fill thy houses, and the houses of all thy servants, and the houses of all the Egyptians; which neither thy fathers, nor thy fathers' fathers have seen, since the day that they were upon the earth unto this day. And he turned himself, and went out from Pharaoh."],"ref":"Exodus 10:6","verse":6,"words":[{"text":"And they shall fill","strong":"H4390"},{"text":" thy houses","strong":"H1004"},{"text":", and the houses","strong":"H1004"},{"text":" of all thy servants","strong":"H5650"},{"text":", and the houses","strong":"H1004"},{"text":" of all the Egyptians","strong":"H4714"},{"text":"; which neither thy fathers","strong":"H1"},{"text":", nor thy fathers","strong":"H1"},{"text":"' fathers","strong":"H1"},{"text":" have seen","strong":"H7200"},{"text":", since the day","strong":"H3117"},{"text":" that they were upon the earth","strong":"H127"},{"text":" unto this day","strong":"H3117"},{"text":". And he turned","strong":"H6437"},{"text":" himself, and went out","strong":"H3318"},{"text":" from Pharaoh","strong":"H6547"},{"text":"."}]},{"id":1784,"title":"Exodus 10:7","segments":["And Pharaoh's servants said unto him, How long shall this man be a snare unto us? let the men go, that they may serve the LORD their God: knowest thou not yet that Egypt is destroyed?"],"ref":"Exodus 10:7","verse":7,"words":[{"text":"And Pharaoh's","strong":"H6547"},{"text":" servants","strong":"H5650"},{"text":" said","strong":"H559"},{"text":" unto him, How long shall this man be a snare","strong":"H4170"},{"text":" unto us? let the men","strong":"H582"},{"text":" go","strong":"H7971"},{"text":", that they may serve","strong":"H5647"},{"text":" the LORD","strong":"H3068"},{"text":" their God","strong":"H430"},{"text":": knowest","strong":"H3045"},{"text":" thou not yet","strong":"H2962"},{"text":" that Egypt","strong":"H4714"},{"text":" is destroyed","strong":"H6"},{"text":"?"}]},{"id":1785,"title":"Exodus 10:8","segments":["And Moses and Aaron were brought again unto Pharaoh: and he said unto them, Go, serve the LORD your God: [but] who [are] they that shall go? {who...: Heb. who and who, etc}"],"ref":"Exodus 10:8","verse":8,"words":[{"text":"And Moses","strong":"H4872"},{"text":" and Aaron","strong":"H175"},{"text":" were brought again","strong":"H7725"},{"text":" unto Pharaoh","strong":"H6547"},{"text":": and he said","strong":"H559"},{"text":" unto them, Go","strong":"H3212"},{"text":", serve","strong":"H5647"},{"text":" the LORD","strong":"H3068"},{"text":" your God","strong":"H430"},{"text":": [but] who [are] they that shall go","strong":"H1980"},{"text":"? {who...: Heb. who and who, etc}"}]},{"id":1786,"title":"Exodus 10:9","segments":["And Moses said, We will go with our young and with our old, with our sons and with our daughters, with our flocks and with our herds will we go; for we [must hold] a feast unto the LORD."],"ref":"Exodus 10:9","verse":9,"words":[{"text":"And Moses","strong":"H4872"},{"text":" said","strong":"H559"},{"text":", We will go","strong":"H3212"},{"text":" with our young","strong":"H5288"},{"text":" and with our old","strong":"H2205"},{"text":", with our sons","strong":"H1121"},{"text":" and with our daughters","strong":"H1323"},{"text":", with our flocks","strong":"H6629"},{"text":" and with our herds","strong":"H1241"},{"text":" will we go","strong":"H3212"},{"text":"; for we [must hold] a feast","strong":"H2282"},{"text":" unto the LORD","strong":"H3068"},{"text":"."}]},{"id":1787,"title":"Exodus 10:10","segments":["And he said unto them, Let the LORD be so with you, as I will let you go, and your little ones: look [to it]; for evil [is] before you."],"ref":"Exodus 10:10","verse":10,"words":[{"text":"And he said","strong":"H559"},{"text":" unto them, Let the LORD","strong":"H3068"},{"text":" be so with you, as I will let you go","strong":"H7971"},{"text":", and your little ones","strong":"H2945"},{"text":": look","strong":"H7200"},{"text":" [to it]; for evil","strong":"H7451"},{"text":" [is] before","strong":"H6440"},{"text":" you."}]},{"id":1788,"title":"Exodus 10:11","segments":["Not so: go now ye [that are] men, and serve the LORD; for that ye did desire. And they were driven out from Pharaoh's presence."],"ref":"Exodus 10:11","verse":11,"words":[{"text":"Not so: go","strong":"H3212"},{"text":" now ye [that are] men","strong":"H1397"},{"text":", and serve","strong":"H5647"},{"text":" the LORD","strong":"H3068"},{"text":"; for that ye did desire","strong":"H1245"},{"text":". And they were driven out","strong":"H1644"},{"text":" from Pharaoh's","strong":"H6547"},{"text":" presence","strong":"H6440"},{"text":"."}]},{"id":1789,"title":"Exodus 10:12","segments":["¶And the LORD said unto Moses, Stretch out thine hand over the land of Egypt for the locusts, that they may come up upon the land of Egypt, and eat every herb of the land, [even] all that the hail hath left."],"ref":"Exodus 10:12","verse":12,"words":[{"text":"¶And the LORD","strong":"H3068"},{"text":" said","strong":"H559"},{"text":" unto Moses","strong":"H4872"},{"text":", Stretch out","strong":"H5186"},{"text":" thine hand","strong":"H3027"},{"text":" over the land","strong":"H776"},{"text":" of Egypt","strong":"H4714"},{"text":" for the locusts","strong":"H697"},{"text":", that they may come up","strong":"H5927"},{"text":" upon the land","strong":"H776"},{"text":" of Egypt","strong":"H4714"},{"text":", and eat","strong":"H398"},{"text":" every herb","strong":"H6212"},{"text":" of the land","strong":"H776"},{"text":", [even] all that the hail","strong":"H1259"},{"text":" hath left","strong":"H7604"},{"text":"."}]},{"id":1790,"title":"Exodus 10:13","segments":["And Moses stretched forth his rod over the land of Egypt, and the LORD brought an east wind upon the land all that day, and all [that] night; [and] when it was morning, the east wind brought the locusts."],"ref":"Exodus 10:13","verse":13,"words":[{"text":"And Moses","strong":"H4872"},{"text":" stretched forth","strong":"H5186"},{"text":" his rod","strong":"H4294"},{"text":" over the land","strong":"H776"},{"text":" of Egypt","strong":"H4714"},{"text":", and the LORD","strong":"H3068"},{"text":" brought","strong":"H5090"},{"text":" an east","strong":"H6921"},{"text":" wind","strong":"H7307"},{"text":" upon the land","strong":"H776"},{"text":" all that day","strong":"H3117"},{"text":", and all [that] night","strong":"H3915"},{"text":"; [and] when it was morning","strong":"H1242"},{"text":", the east","strong":"H6921"},{"text":" wind","strong":"H7307"},{"text":" brought","strong":"H5375"},{"text":" the locusts","strong":"H697"},{"text":"."}]},{"id":1791,"title":"Exodus 10:14","segments":["And the locusts went up over all the land of Egypt, and rested in all the coasts of Egypt: very grievous [were they]; before them there were no such locusts as they, neither after them shall be such."],"ref":"Exodus 10:14","verse":14,"words":[{"text":"And the locusts","strong":"H697"},{"text":" went up","strong":"H5927"},{"text":" over all the land","strong":"H776"},{"text":" of Egypt","strong":"H4714"},{"text":", and rested","strong":"H5117"},{"text":" in all the coasts","strong":"H1366"},{"text":" of Egypt","strong":"H4714"},{"text":": very","strong":"H3966"},{"text":" grievous","strong":"H3515"},{"text":" [were they]; before","strong":"H6440"},{"text":" them there were no such","strong":"H3651"},{"text":" locusts","strong":"H697"},{"text":" as they, neither after","strong":"H310"},{"text":" them shall be such."}]},{"id":1792,"title":"Exodus 10:15","segments":["For they covered the face of the whole earth, so that the land was darkened; and they did eat every herb of the land, and all the fruit of the trees which the hail had left: and there remained not any green thing in the trees, or in the herbs of the field, through all the land of Egypt."],"ref":"Exodus 10:15","verse":15,"words":[{"text":"For they covered","strong":"H3680"},{"text":" the face","strong":"H5869"},{"text":" of the whole earth","strong":"H776"},{"text":", so that the land","strong":"H776"},{"text":" was darkened","strong":"H2821"},{"text":"; and they did eat","strong":"H398"},{"text":" every herb","strong":"H6212"},{"text":" of the land","strong":"H776"},{"text":", and all the fruit","strong":"H6529"},{"text":" of the trees","strong":"H6086"},{"text":" which the hail","strong":"H1259"},{"text":" had left","strong":"H3498"},{"text":": and there remained","strong":"H3498"},{"text":" not any green thing","strong":"H3418"},{"text":" in the trees","strong":"H6086"},{"text":", or in the herbs","strong":"H6212"},{"text":" of the field","strong":"H7704"},{"text":", through all the land","strong":"H776"},{"text":" of Egypt","strong":"H4714"},{"text":"."}]},{"id":1793,"title":"Exodus 10:16","segments":["Then Pharaoh called for Moses and Aaron in haste; and he said, I have sinned against the LORD your God, and against you. {called: Heb. hastened to call}"],"ref":"Exodus 10:16","verse":16,"words":[{"text":"Then Pharaoh","strong":"H6547"},{"text":" called","strong":"H7121"},{"text":" for Moses","strong":"H4872"},{"text":" and Aaron","strong":"H175"},{"text":" in haste","strong":"H4116"},{"text":"; and he said","strong":"H559"},{"text":", I have sinned","strong":"H2398"},{"text":" against the LORD","strong":"H3068"},{"text":" your God","strong":"H430"},{"text":", and against you. {called: Heb. hastened to call}"}]},{"id":1794,"title":"Exodus 10:17","segments":["Now therefore forgive, I pray thee, my sin only this once, and intreat the LORD your God, that he may take away from me this death only."],"ref":"Exodus 10:17","verse":17,"words":[{"text":"Now therefore forgive","strong":"H5375"},{"text":", I pray thee, my sin","strong":"H2403"},{"text":" only this once","strong":"H6471"},{"text":", and intreat","strong":"H6279"},{"text":" the LORD","strong":"H3068"},{"text":" your God","strong":"H430"},{"text":", that he may take away","strong":"H5493"},{"text":" from me this death","strong":"H4194"},{"text":" only."}]},{"id":1795,"title":"Exodus 10:18","segments":["And he went out from Pharaoh, and intreated the LORD."],"ref":"Exodus 10:18","verse":18,"words":[{"text":"And he went out","strong":"H3318"},{"text":" from Pharaoh","strong":"H6547"},{"text":", and intreated","strong":"H6279"},{"text":" the LORD","strong":"H3068"},{"text":"."}]},{"id":1796,"title":"Exodus 10:19","segments":["And the LORD turned a mighty strong west wind, which took away the locusts, and cast them into the Red sea; there remained not one locust in all the coasts of Egypt. {cast: Heb. fastened}"],"ref":"Exodus 10:19","verse":19,"words":[{"text":"And the LORD","strong":"H3068"},{"text":" turned","strong":"H2015"},{"text":" a mighty","strong":"H3966"},{"text":" strong","strong":"H2389"},{"text":" west","strong":"H3220"},{"text":" wind","strong":"H7307"},{"text":", which took away","strong":"H5375"},{"text":" the locusts","strong":"H697"},{"text":", and cast","strong":"H8628"},{"text":" them into the Red","strong":"H5488"},{"text":" sea","strong":"H3220"},{"text":"; there remained","strong":"H7604"},{"text":" not one","strong":"H259"},{"text":" locust","strong":"H697"},{"text":" in all the coasts","strong":"H1366"},{"text":" of Egypt","strong":"H4714"},{"text":". {cast: Heb. fastened}"}]},{"id":1797,"title":"Exodus 10:20","segments":["But the LORD hardened Pharaoh's heart, so that he would not let the children of Israel go."],"ref":"Exodus 10:20","verse":20,"words":[{"text":"But the LORD","strong":"H3068"},{"text":" hardened","strong":"H2388"},{"text":" Pharaoh's","strong":"H6547"},{"text":" heart","strong":"H3820"},{"text":", so that he would not let the children","strong":"H1121"},{"text":" of Israel","strong":"H3478"},{"text":" go","strong":"H7971"},{"text":"."}]},{"id":1798,"title":"Exodus 10:21","segments":["¶And the LORD said unto Moses, Stretch out thine hand toward heaven, that there may be darkness over the land of Egypt, even darkness [which] may be felt. {even...: Heb. that one may feel darkness}"],"ref":"Exodus 10:21","verse":21,"words":[{"text":"¶And the LORD","strong":"H3068"},{"text":" said","strong":"H559"},{"text":" unto Moses","strong":"H4872"},{"text":", Stretch out","strong":"H5186"},{"text":" thine hand","strong":"H3027"},{"text":" toward heaven","strong":"H8064"},{"text":", that there may be darkness","strong":"H2822"},{"text":" over the land","strong":"H776"},{"text":" of Egypt","strong":"H4714"},{"text":", even darkness","strong":"H2822"},{"text":" [which] may be felt","strong":"H4959"},{"text":". {even...: Heb. that one may feel darkness}"}]},{"id":1799,"title":"Exodus 10:22","segments":["And Moses stretched forth his hand toward heaven; and there was a thick darkness in all the land of Egypt three days:"],"ref":"Exodus 10:22","verse":22,"words":[{"text":"And Moses","strong":"H4872"},{"text":" stretched forth","strong":"H5186"},{"text":" his hand","strong":"H3027"},{"text":" toward heaven","strong":"H8064"},{"text":"; and there was a thick","strong":"H653"},{"text":" darkness","strong":"H2822"},{"text":" in all the land","strong":"H776"},{"text":" of Egypt","strong":"H4714"},{"text":" three","strong":"H7969"},{"text":" days","strong":"H3117"},{"text":":"}]},{"id":1800,"title":"Exodus 10:23","segments":["They saw not one another, neither rose any from his place for three days: but all the children of Israel had light in their dwellings."],"ref":"Exodus 10:23","verse":23,"words":[{"text":"They saw","strong":"H7200"},{"text":" not one","strong":"H376"},{"text":" another","strong":"H251"},{"text":", neither rose","strong":"H6965"},{"text":" any","strong":"H376"},{"text":" from his place for three","strong":"H7969"},{"text":" days","strong":"H3117"},{"text":": but all the children","strong":"H1121"},{"text":" of Israel","strong":"H3478"},{"text":" had light","strong":"H216"},{"text":" in their dwellings","strong":"H4186"},{"text":"."}]},{"id":1801,"title":"Exodus 10:24","segments":["And Pharaoh called unto Moses, and said, Go ye, serve the LORD; only let your flocks and your herds be stayed: let your little ones also go with you."],"ref":"Exodus 10:24","verse":24,"words":[{"text":"And Pharaoh","strong":"H6547"},{"text":" called","strong":"H7121"},{"text":" unto Moses","strong":"H4872"},{"text":", and said","strong":"H559"},{"text":", Go","strong":"H3212"},{"text":" ye, serve","strong":"H5647"},{"text":" the LORD","strong":"H3068"},{"text":"; only let your flocks","strong":"H6629"},{"text":" and your herds","strong":"H1241"},{"text":" be stayed","strong":"H3322"},{"text":": let your little ones","strong":"H2945"},{"text":" also go","strong":"H3212"},{"text":" with you."}]},{"id":1802,"title":"Exodus 10:25","segments":["And Moses said, Thou must give us also sacrifices and burnt offerings, that we may sacrifice unto the LORD our God. {us: Heb. into our hands}"],"ref":"Exodus 10:25","verse":25,"words":[{"text":"And Moses","strong":"H4872"},{"text":" said","strong":"H559"},{"text":", Thou must give","strong":"H5414"},{"text":" us","strong":"H3027"},{"text":" also sacrifices","strong":"H2077"},{"text":" and burnt offerings","strong":"H5930"},{"text":", that we may sacrifice","strong":"H6213"},{"text":" unto the LORD","strong":"H3068"},{"text":" our God","strong":"H430"},{"text":". {us: Heb. into our hands}"}]},{"id":1803,"title":"Exodus 10:26","segments":["Our cattle also shall go with us; there shall not an hoof be left behind; for thereof must we take to serve the LORD our God; and we know not with what we must serve the LORD, until we come thither."],"ref":"Exodus 10:26","verse":26,"words":[{"text":"Our cattle","strong":"H4735"},{"text":" also shall go","strong":"H3212"},{"text":" with us; there shall not an hoof","strong":"H6541"},{"text":" be left behind","strong":"H7604"},{"text":"; for thereof must we take","strong":"H3947"},{"text":" to serve","strong":"H5647"},{"text":" the LORD","strong":"H3068"},{"text":" our God","strong":"H430"},{"text":"; and we know","strong":"H3045"},{"text":" not with what we must serve","strong":"H5647"},{"text":" the LORD","strong":"H3068"},{"text":", until we come","strong":"H935"},{"text":" thither."}]},{"id":1804,"title":"Exodus 10:27","segments":["But the LORD hardened Pharaoh's heart, and he would not let them go."],"ref":"Exodus 10:27","verse":27,"words":[{"text":"But the LORD","strong":"H3068"},{"text":" hardened","strong":"H2388"},{"text":" Pharaoh's","strong":"H6547"},{"text":" heart","strong":"H3820"},{"text":", and he would","strong":"H14"},{"text":" not let them go","strong":"H7971"},{"text":"."}]},{"id":1805,"title":"Exodus 10:28","segments":["And Pharaoh said unto him, Get thee from me, take heed to thyself, see my face no more; for in [that] day thou seest my face thou shalt die."],"ref":"Exodus 10:28","verse":28,"words":[{"text":"And Pharaoh","strong":"H6547"},{"text":" said","strong":"H559"},{"text":" unto him, Get","strong":"H3212"},{"text":" thee from me, take heed","strong":"H8104"},{"text":" to thyself, see","strong":"H7200"},{"text":" my face","strong":"H6440"},{"text":" no more","strong":"H3254"},{"text":"; for in [that] day","strong":"H3117"},{"text":" thou seest","strong":"H7200"},{"text":" my face","strong":"H6440"},{"text":" thou shalt die","strong":"H4191"},{"text":"."}]},{"id":1806,"title":"Exodus 10:29","segments":["And Moses said, Thou hast spoken well, I will see thy face again no more."],"ref":"Exodus 10:29","verse":29,"words":[{"text":"And Moses","strong":"H4872"},{"text":" said","strong":"H559"},{"text":", Thou hast spoken","strong":"H1696"},{"text":" well","strong":"H3651"},{"text":", I will see","strong":"H7200"},{"text":" thy face","strong":"H6440"},{"text":" again","strong":"H3254"},{"text":" no more."}]}]}
