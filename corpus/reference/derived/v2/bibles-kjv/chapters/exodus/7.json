{"book":"Exodus","chapter":7,"entries":[{"id":1686,"title":"Exodus 7:1","segments":["¶And the LORD said unto Moses, See, I have made thee a god to Pharaoh: and Aaron thy brother shall be thy prophet."],"ref":"Exodus 7:1","verse":1,"words":[{"text":"¶And the LORD","strong":"H3068"},{"text":" said","strong":"H559"},{"text":" unto Moses","strong":"H4872"},{"text":", See","strong":"H7200"},{"text":", I have made","strong":"H5414"},{"text":" thee a god","strong":"H430"},{"text":" to Pharaoh","strong":"H6547"},{"text":": and Aaron","strong":"H175"},{"text":" thy brother","strong":"H251"},{"text":" shall be thy prophet","strong":"H5030"},{"text":"."}]},{"id":1687,"title":"Exodus 7:2","segments":["Thou shalt speak all that I command thee: and Aaron thy brother shall speak unto Pharaoh, that he send the children of Israel out of his land."],"ref":"Exodus 7:2","verse":2,"words":[{"text":"Thou shalt speak","strong":"H1696"},{"text":" all that I command","strong":"H6680"},{"text":" thee: and Aaron","strong":"H175"},{"text":" thy brother","strong":"H251"},{"text":" shall speak","strong":"H1696"},{"text":" unto Pharaoh","strong":"H6547"},{"text":", that he send","strong":"H7971"},{"text":" the children","strong":"H1121"},{"text":" of Israel","strong":"H3478"},{"text":" out of his land","strong":"H776"},{"text":"."}]},{"id":1688,"title":"Exodus 7:3","segments":["And I will harden Pharaoh's heart, and multiply my signs and my wonders in the land of Egypt."],"ref":"Exodus 7:3","verse":3,"words":[{"text":"And I will harden","strong":"H7185"},{"text":" Pharaoh's","strong":"H6547"},{"text":" heart","strong":"H3820"},{"text":", and multiply","strong":"H7235"},{"text":" my signs","strong":"H226"},{"text":" and my wonders","strong":"H4159"},{"text":" in the land","strong":"H776"},{"text":" of Egypt","strong":"H4714"},{"text":"."}]},{"id":1689,"title":"Exodus 7:4","segments":["But Pharaoh shall not hearken unto you, that I may lay my hand upon Egypt, and bring forth mine armies, [and] my p