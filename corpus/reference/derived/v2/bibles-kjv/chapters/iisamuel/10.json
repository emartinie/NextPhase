{"book":"II Samuel","chapter":10,"entries":[{"id":8241,"title":"II Samuel 10:1","segments":["¶And it came to pass after this, that the king of the children of Ammon died, and Hanun his son reigned in his stead."],"ref":"II Samuel 10:1","verse":1,"words":[{"text":"¶And it came to pass after this","strong":"H310"},{"text":", that the king","strong":"H4428"},{"text":" of the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":" died","strong":"H4191"},{"text":", and Hanun","strong":"H2586"},{"text":" his son","strong":"H1121"},{"text":" reigned","strong":"H4427"},{"text":" in his stead."}]},{"id":8242,"title":"II Samuel 10:2","segments":["Then said David, I will shew kindness unto Hanun the son of Nahash, as his father shewed kindness unto me. And David sent to comfort him by the hand of his servants for his father. And David's servants came into the land of the children of Ammon."],"ref":"II Samuel 10:2","verse":2,"words":[{"text":"Then said","strong":"H559"},{"text":" David","strong":"H1732"},{"text":", I will shew","strong":"H6213"},{"text":" kindness","strong":"H2617"},{"text":" unto Hanun","strong":"H2586"},{"text":" the son","strong":"H1121"},{"text":" of Nahash","strong":"H5176"},{"text":", as his father","strong":"H1"},{"text":" shewed","strong":"H6213"},{"text":" kindness","strong":"H2617"},{"text":" unto me. And David","strong":"H1732"},{"text":" sent","strong":"H7971"},{"text":" to comfort","strong":"H5162"},{"text":" him by the hand","strong":"H3027"},{"text":" of his servants","strong":"H5650"},{"text":" for his father","strong":"H1"},{"text":". And David's","strong":"H1732"},{"text":" servants","strong":"H5650"},{"text":" came","strong":"H935"},{"text":" into the land","strong":"H776"},{"text":" of the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":"."}]},{"id":8243,"title":"II Samuel 10:3","segments":["And the princes of the children of Ammon said unto Hanun their lord, Thinkest thou that David doth honour thy father, that he hath sent comforters unto thee? hath not David [rather] sent his servants unto thee, to search the city, and to spy it out, and to overthrow it? {Thinkest...: Heb. In thy eyes doth David}"],"ref":"II Samuel 10:3","verse":3,"words":[{"text":"And the princes","strong":"H8269"},{"text":" of the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":" said","strong":"H559"},{"text":" unto Hanun","strong":"H2586"},{"text":" their lord","strong":"H113"},{"text":", Thinkest","strong":"H5869"},{"text":" thou that David","strong":"H1732"},{"text":" doth honour","strong":"H3513"},{"text":" thy father","strong":"H1"},{"text":", that he hath sent","strong":"H7971"},{"text":" comforters","strong":"H5162"},{"text":" unto thee? hath not David","strong":"H1732"},{"text":" [rather] sent","strong":"H7971"},{"text":" his servants","strong":"H5650"},{"text":" unto thee, to","strong":"H5668"},{"text":" search","strong":"H2713"},{"text":" the city","strong":"H5892"},{"text":", and to spy it out","strong":"H7270"},{"text":", and to overthrow","strong":"H2015"},{"text":" it? {Thinkest...: Heb. In thy eyes doth David}"}]},{"id":8244,"title":"II Samuel 10:4","segments":["Wherefore Hanun took David's servants, and shaved off the one half of their beards, and cut off their garments in the middle, [even] to their buttocks, and sent them away."],"ref":"II Samuel 10:4","verse":4,"words":[{"text":"Wherefore Hanun","strong":"H2586"},{"text":" took","strong":"H3947"},{"text":" David's","strong":"H1732"},{"text":" servants","strong":"H5650"},{"text":", and shaved off","strong":"H1548"},{"text":" the one half","strong":"H2677"},{"text":" of their beards","strong":"H2206"},{"text":", and cut off","strong":"H3772"},{"text":" their garments","strong":"H4063"},{"text":" in the middle","strong":"H2677"},{"text":", [even] to their buttocks","strong":"H8357"},{"text":", and sent them away","strong":"H7971"},{"text":"."}]},{"id":8245,"title":"II Samuel 10:5","segments":["When they told [it] unto David, he sent to meet them, because the men were greatly ashamed: and the king said, Tarry at Jericho until your beards be grown, and [then] return."],"ref":"II Samuel 10:5","verse":5,"words":[{"text":"When they told","strong":"H5046"},{"text":" [it] unto David","strong":"H1732"},{"text":", he sent","strong":"H7971"},{"text":" to meet","strong":"H7125"},{"text":" them, because the men","strong":"H582"},{"text":" were greatly","strong":"H3966"},{"text":" ashamed","strong":"H3637"},{"text":": and the king","strong":"H4428"},{"text":" said","strong":"H559"},{"text":", Tarry","strong":"H3427"},{"text":" at Jericho","strong":"H3405"},{"text":" until your beards","strong":"H2206"},{"text":" be grown","strong":"H6779"},{"text":", and [then] return","strong":"H7725"},{"text":"."}]},{"id":8246,"title":"II Samuel 10:6","segments":["¶And when the children of Ammon saw that they stank before David, the children of Ammon sent and hired the Syrians of Bethrehob, and the Syrians of Zoba, twenty thousand footmen, and of king Maacah a thousand men, and of Ishtob twelve thousand men. {Ishtob: or, the men of Tob}"],"ref":"II Samuel 10:6","verse":6,"words":[{"text":"¶And when the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":" saw","strong":"H7200"},{"text":" that they stank","strong":"H887"},{"text":" before David","strong":"H1732"},{"text":", the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":" sent","strong":"H7971"},{"text":" and hired","strong":"H7936"},{"text":" the Syrians","strong":"H758"},{"text":" of Bethrehob","strong":"H1050"},{"text":", and the Syrians","strong":"H758"},{"text":" of Zoba","strong":"H6678"},{"text":", twenty","strong":"H6242"},{"text":" thousand","strong":"H505"},{"text":" footmen","strong":"H7273"},{"text":", and of king","strong":"H4428"},{"text":" Maacah","strong":"H4601"},{"text":" a thousand","strong":"H505"},{"text":" men","strong":"H376"},{"text":", and of Ishtob","strong":"H382"},{"text":" twelve","strong":"H6240"},{"text":"","strong":"H8147"},{"text":" thousand","strong":"H505"},{"text":" men","strong":"H376"},{"text":". {Ishtob: or, the men of Tob}"}]},{"id":8247,"title":"II Samuel 10:7","segments":["And when David heard of [it], he sent Joab, and all the host of the mighty men."],"ref":"II Samuel 10:7","verse":7,"words":[{"text":"And when David","strong":"H1732"},{"text":" heard","strong":"H8085"},{"text":" of [it], he sent","strong":"H7971"},{"text":" Joab","strong":"H3097"},{"text":", and all the host","strong":"H6635"},{"text":" of the mighty men","strong":"H1368"},{"text":"."}]},{"id":8248,"title":"II Samuel 10:8","segments":["And the children of Ammon came out, and put the battle in array at the entering in of the gate: and the Syrians of Zoba, and of Rehob, and Ishtob, and Maacah, [were] by themselves in the field."],"ref":"II Samuel 10:8","verse":8,"words":[{"text":"And the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":" came out","strong":"H3318"},{"text":", and put the battle","strong":"H4421"},{"text":" in array","strong":"H6186"},{"text":" at the entering in","strong":"H6607"},{"text":" of the gate","strong":"H8179"},{"text":": and the Syrians","strong":"H758"},{"text":" of Zoba","strong":"H6678"},{"text":", and of Rehob","strong":"H7340"},{"text":", and Ishtob","strong":"H382"},{"text":", and Maacah","strong":"H4601"},{"text":", [were] by themselves","strong":"H905"},{"text":" in the field","strong":"H7704"},{"text":"."}]},{"id":8249,"title":"II Samuel 10:9","segments":["When Joab saw that the front of the battle was against him before and behind, he chose of all the choice [men] of Israel, and put [them] in array against the Syrians:"],"ref":"II Samuel 10:9","verse":9,"words":[{"text":"When Joab","strong":"H3097"},{"text":" saw","strong":"H7200"},{"text":" that the front","strong":"H6440"},{"text":" of the battle","strong":"H4421"},{"text":" was against him before","strong":"H6440"},{"text":" and behind","strong":"H268"},{"text":", he chose","strong":"H977"},{"text":" of all the choice","strong":"H977"},{"text":" [men] of Israel","strong":"H3478"},{"text":", and put [them] in array","strong":"H6186"},{"text":" against","strong":"H7125"},{"text":" the Syrians","strong":"H758"},{"text":":"}]},{"id":8250,"title":"II Samuel 10:10","segments":["And the rest of the people he delivered into the hand of Abishai his brother, that he might put [them] in array against the children of Ammon."],"ref":"II Samuel 10:10","verse":10,"words":[{"text":"And the rest","strong":"H3499"},{"text":" of the people","strong":"H5971"},{"text":" he delivered","strong":"H5414"},{"text":" into the hand","strong":"H3027"},{"text":" of Abishai","strong":"H52"},{"text":" his brother","strong":"H251"},{"text":", that he might put [them] in array","strong":"H6186"},{"text":" against","strong":"H7125"},{"text":" the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":"."}]},{"id":8251,"title":"II Samuel 10:11","segments":["And he said, If the Syrians be too strong for me, then thou shalt help me: but if the children of Ammon be too strong for thee, then I will come and help thee."],"ref":"II Samuel 10:11","verse":11,"words":[{"text":"And he said","strong":"H559"},{"text":", If the Syrians","strong":"H758"},{"text":" be too strong","strong":"H2388"},{"text":" for me, then thou shalt help","strong":"H3444"},{"text":" me: but if the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":" be too strong","strong":"H2388"},{"text":" for thee, then I will come","strong":"H1980"},{"text":" and help","strong":"H3467"},{"text":" thee."}]},{"id":8252,"title":"II Samuel 10:12","segments":["Be of good courage, and let us play the men for our people, and for the cities of our God: and the LORD do that which seemeth him good."],"ref":"II Samuel 10:12","verse":12,"words":[{"text":"Be of good courage","strong":"H2388"},{"text":", and let us play the men","strong":"H2388"},{"text":" for our people","strong":"H5971"},{"text":", and for the cities","strong":"H5892"},{"text":" of our God","strong":"H430"},{"text":": and the LORD","strong":"H3068"},{"text":" do","strong":"H6213"},{"text":" that which seemeth","strong":"H5869"},{"text":" him good","strong":"H2896"},{"text":"."}]},{"id":8253,"title":"II Samuel 10:13","segments":["And Joab drew nigh, and the people that [were] with him, unto the battle against the Syrians: and they fled before him."],"ref":"II Samuel 10:13","verse":13,"words":[{"text":"And Joab","strong":"H3097"},{"text":" drew nigh","strong":"H5066"},{"text":", and the people","strong":"H5971"},{"text":" that [were] with him, unto the battle","strong":"H4421"},{"text":" against the Syrians","strong":"H758"},{"text":": and they fled","strong":"H5127"},{"text":" before","strong":"H6440"},{"text":" him."}]},{"id":8254,"title":"II Samuel 10:14","segments":["And when the children of Ammon saw that the Syrians were fled, then fled they also before Abishai, and entered into the city. So Joab returned from the children of Ammon, and came to Jerusalem."],"ref":"II Samuel 10:14","verse":14,"words":[{"text":"And when the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":" saw","strong":"H7200"},{"text":" that the Syrians","strong":"H758"},{"text":" were fled","strong":"H5127"},{"text":", then fled","strong":"H5127"},{"text":" they also before","strong":"H6440"},{"text":" Abishai","strong":"H52"},{"text":", and entered","strong":"H935"},{"text":" into the city","strong":"H5892"},{"text":". So Joab","strong":"H3097"},{"text":" returned","strong":"H7725"},{"text":" from the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":", and came","strong":"H935"},{"text":" to Jerusalem","strong":"H3389"},{"text":"."}]},{"id":8255,"title":"II Samuel 10:15","segments":["¶And when the Syrians saw that they were smitten before Israel, they gathered themselves together."],"ref":"II Samuel 10:15","verse":15,"words":[{"text":"¶And when the Syrians","strong":"H758"},{"text":" saw","strong":"H7200"},{"text":" that they were smitten","strong":"H5062"},{"text":" before","strong":"H6440"},{"text":" Israel","strong":"H3478"},{"text":", they gathered","strong":"H622"},{"text":" themselves together","strong":"H3162"},{"text":"."}]},{"id":8256,"title":"II Samuel 10:16","segments":["And Hadarezer sent, and brought out the Syrians that [were] beyond the river: and they came to Helam; and Shobach the captain of the host of Hadarezer [went] before them. {the river: that is, Euphrates} {Shobach: or, Shophach}"],"ref":"II Samuel 10:16","verse":16,"words":[{"text":"And Hadarezer","strong":"H1928"},{"text":" sent","strong":"H7971"},{"text":", and brought out","strong":"H3318"},{"text":" the Syrians","strong":"H758"},{"text":" that [were] beyond","strong":"H5676"},{"text":" the river","strong":"H5104"},{"text":": and they came","strong":"H935"},{"text":" to Helam","strong":"H2431"},{"text":"; and Shobach","strong":"H7731"},{"text":" the captain","strong":"H8269"},{"text":" of the host","strong":"H6635"},{"text":" of Hadarezer","strong":"H1928"},{"text":" [went] before","strong":"H6440"},{"text":" them. {the river: that is, Euphrates} {Shobach: or, Shophach}"}]},{"id":8257,"title":"II Samuel 10:17","segments":["And when it was told David, he gathered all Israel together, and passed over Jordan, and came to Helam. And the Syrians set themselves in array against David, and fought with him."],"ref":"II Samuel 10:17","verse":17,"words":[{"text":"And when it was told","strong":"H5046"},{"text":" David","strong":"H1732"},{"text":", he gathered","strong":"H622"},{"text":" all Israel","strong":"H3478"},{"text":" together","strong":"H622"},{"text":", and passed over","strong":"H5674"},{"text":" Jordan","strong":"H3383"},{"text":", and came","strong":"H935"},{"text":" to Helam","strong":"H2431"},{"text":". And the Syrians","strong":"H758"},{"text":" set themselves in array","strong":"H6186"},{"text":" against","strong":"H7125"},{"text":" David","strong":"H1732"},{"text":", and fought","strong":"H3898"},{"text":" with him."}]},{"id":8258,"title":"II Samuel 10:18","segments":["And the Syrians fled before Israel; and David slew [the men of] seven hundred chariots of the Syrians, and forty thousand horsemen, and smote Shobach the captain of their host, who died there. {horsemen: also called, footmen}"],"ref":"II Samuel 10:18","verse":18,"words":[{"text":"And the Syrians","strong":"H758"},{"text":" fled","strong":"H5127"},{"text":" before","strong":"H6440"},{"text":" Israel","strong":"H3478"},{"text":"; and David","strong":"H1732"},{"text":" slew","strong":"H2026"},{"text":" [the men of] seven","strong":"H7651"},{"text":" hundred","strong":"H3967"},{"text":" chariots","strong":"H7393"},{"text":" of the Syrians","strong":"H758"},{"text":", and forty","strong":"H705"},{"text":" thousand","strong":"H505"},{"text":" horsemen","strong":"H6571"},{"text":", and smote","strong":"H5221"},{"text":" Shobach","strong":"H7731"},{"text":" the captain","strong":"H8269"},{"text":" of their host","strong":"H6635"},{"text":", who died","strong":"H4191"},{"text":" there. {horsemen: also called, footmen}"}]},{"id":8259,"title":"II Samuel 10:19","segments":["And when all the kings [that were] servants to Hadarezer saw that they were smitten before Israel, they made peace with Israel, and served them. So the Syrians feared to help the children of Ammon any more."],"ref":"II Samuel 10:19","verse":19,"words":[{"text":"And when all the kings","strong":"H4428"},{"text":" [that were] servants","strong":"H5650"},{"text":" to Hadarezer","strong":"H1928"},{"text":" saw","strong":"H7200"},{"text":" that they were smitten","strong":"H5062"},{"text":" before","strong":"H6440"},{"text":" Israel","strong":"H3478"},{"text":", they made peace","strong":"H7999"},{"text":" with Israel","strong":"H3478"},{"text":", and served","strong":"H5647"},{"text":" them. So the Syrians","strong":"H758"},{"text":" feared","strong":"H3372"},{"text":" to help","strong":"H3467"},{"text":" the children","strong":"H1121"},{"text":" of Ammon","strong":"H5983"},{"text":" any more."}]}]}
