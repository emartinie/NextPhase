,"strong":"H120"},{"text":" remembered","strong":"H2142"},{"text":" that same poor","strong":"H4542"},{"text":" man","strong":"H376"},{"text":"."}]},{"id":17491,"title":"Ecclesiastes 9:16","segments":["Then said I, Wisdom [is] better than strength: nevertheless the poor man's wisdom [is] despised, and his words are not heard."],"ref":"Ecclesiastes 9:16","verse":16,"words":[{"text":"Then said","strong":"H559"},{"text":" I, Wisdom","strong":"H2451"},{"text":" [is] better","strong":"H2896"},{"text":" than strength","strong":"H1369"},{"text":": nevertheless the poor man's","strong":"H4542"},{"text":" wisdom","strong":"H2451"},{"text":" [is] despised","strong":"H959"},{"text":", and his words","strong":"H1697"},{"text":" are not heard","strong":"H8085"},{"text":"."}]},{"id":17492,"title":"Ecclesiastes 9:17","segments":["The words of wise [men are] heard in quiet more than the cry of him that ruleth among fools."],"ref":"Ecclesiastes 9:17","verse":17,"words":[{"text":"The words","strong":"H1697"},{"text":" of wise","strong":"H2450"},{"text":" [men are] heard","strong":"H8085"},{"text":" in quiet","strong":"H5183"},{"text":" more than the cry","strong":"H2201"},{"text":" of him that ruleth","strong":"H4910"},{"text":" among fools","strong":"H3684"},{"text":"."}]},{"id":17493,"title":"Ecclesiastes 9:18","segments":["Wisdom [is] better than weapons of war: but one sinner destroyeth much good."],"ref":"Ecclesiastes 9:18","verse":18,"words":[{"text":"Wisdom","strong":"H2451"},{"text":" [is] better","strong":"H2896"},{"text":" than weapons","strong":"H3627"},{"text":" of war","strong":"H7128"},{"text":": but one","strong":"H259"},{"text":" sinner","strong":"H2398"},{"text":" destroyeth","strong":"H6"},{"text":" much","strong":"H7235"},{"text":" good","strong":"H2896"},{"text":"."}]}]}
