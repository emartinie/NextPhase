f":"Ezra 10:5","verse":5,"words":[{"text":"Then arose","strong":"H6965"},{"text":" Ezra","strong":"H5830"},{"text":", and made the chief","strong":"H8269"},{"text":" priests","strong":"H3548"},{"text":", the Levites","strong":"H3881"},{"text":", and all Israel","strong":"H3478"},{"text":", to swear","strong":"H7650"},{"text":" that they should do","strong":"H6213"},{"text":" according to this word","strong":"H1697"},{"text":". And they sware","strong":"H7650"},{"text":"."}]},{"id":12258,"title":"Ezra 10:6","segments":["¶Then Ezra rose up from before the house of God, and went into the chamber of Johanan the son of Eliashib: and [when] he came thither, he did eat no bread, nor drink water: for he mourned because of the transgression of them that had been carried away."],"ref":"Ezra 10:6","verse":6,"words":[{"text":"¶Then Ezra","strong":"H5830"},{"text":" rose up","strong":"H6965"},{"text":" from before","strong":"H6440"},{"text":" the house","strong":"H1004"},{"text":" of God","strong":"H430"},{"text":", and went","strong":"H3212"},{"text":" into the chamber","strong":"H3957"},{"text":" of Johanan","strong":"H3076"},{"text":" the son","strong":"H1121"},{"text":" of Eliashib","strong":"H475"},{"text":": and [when] he came","strong":"H3212"},{"text":" thither, he did eat","strong":"H398"},{"text":" no bread","strong":"H3899"},{"text":", nor drink","strong":"H8354"},{"text":" water","strong":"H4325"},{"text":": for he mourned","strong":"H56"},{"text":" because of the transgression","strong":"H4604"},{"text":" of them that had been carried away","strong":"H1473"},{"text":"."}]},{"id":12259,"title":"Ezra 10:7","segments":["And they made proclamation throughout Judah and Jerusalem unto all the children of the captivity, that they should gather themselves together unto Jerusalem;"],"ref":"Ezra 10:7","verse":7,"words":[{"text":"And they made proclamation","strong":"H5674"},{"text":"","strong":"H6963"},{"text":" throughout Judah","strong":"H3063"},{"text":" and Jerusalem","strong":"H3389"},{"text":" unto all the children","strong":"H1121"},{"text":" of the captivity","strong":"H1473"},{"text":", that they should gather themselves together","strong":"H6908"},{"text":" unto Jerusalem","strong":"H3389"},{"text":";"}]},{"id":12260,"title":"Ezra 10:8","segments":["And that whosoever would not come within three days, according to the counsel of the princes and the elders, all his substance should be forfeited, and himself separated from the congregation of those that had been carried away. {forfeited: Heb. devoted}"],"ref":"Ezra 10:8","verse":8,"words":[{"text":"And that whosoever would not come","strong":"H935"},{"text":" within three","strong":"H7969"},{"text":" days","strong":"H3117"},{"text":", according to the counsel","strong":"H6098"},{"text":" of the princes","strong":"H8269"},{"text":" and the elders","strong":"H2205"},{"text":", all his substance","strong":"H7399"},{"text":" should be forfeited","strong":"H2763"},{"text":", and himself separated","strong":"H914"},{"text":" from the congregation","strong":"H6951"},{"text":" of those that had been carried away","strong":"H1473"},{"text":". {forfeited: Heb. devoted}"}]},{"id":12261,"title":"Ezra 10:9","segments":["Then all the men of Judah and Benjamin gathered themselves together unto Jerusalem within three days. It [was] the ninth month, on the twentieth [day] of the month; and all the people sat in the street of the house of God, trembling because of [this] matter, and for the great rain. {the great...: Heb. the showers}"],"ref":"Ezra 10:9","verse":9,"words":[{"text":"Then all the men","strong":"H582"},{"text":" of Judah","strong":"H3063"},{"text":" and Benjamin","strong":"H1144"},{"text":" gathered themselves together","strong":"H6908"},{"text":" unto Jerusalem","strong":"H3389"},{"text":" within three","strong":"H7969"},{"text":" days","strong":"H3117"},{"text":". It [was] the ninth","strong":"H8671"},{"text":" month","strong":"H2320"},{"text":", on the twentieth","strong":"H6242"},{"text":" [day] of the month","strong":"H2320"},{"text":"; and all the people","strong":"H5971"},{"text":" sat","strong":"H3427"},{"text":" in the street","strong":"H7339"},{"text":" of the house","strong":"H1004"},{"text":" of God","strong":"H430"},{"text":", trembling","strong":"H7460"},{"text":" because of [this] matter","strong":"H1697"},{"text":", and for the great rain","strong":"H1653"},{"text":". {the great...: Heb. the showers}"}]},{"id":12262,"title":"Ezra 10:10","segments":["And Ezra the priest stood up, and said unto them, Ye have transgressed, and have taken strange wives, to increase the trespass of Israel. {have taken: Heb. have caused to dwell, or, have brought back}"],"ref":"Ezra 10:10","verse":10,"words":[{"text":"And Ezra","strong":"H5830"},{"text":" the priest","strong":"H3548"},{"text":" stood up","strong":"H6965"},{"text":", and said","strong":"H559"},{"text":" unto them, Ye have transgressed","strong":"H4603"},{"text":", and have taken","strong":"H3427"},{"text":" strange","strong":"H5237"},{"text":" wives","strong":"H802"},{"text":", to increase","strong":"H3254"},{"text":" the trespass","strong":"H819"},{"text":" of Israel","strong":"H3478"},{"text":". {have taken: Heb. have caused to dwell, or, have brought back}"}]},{"id":12263,"title":"Ezra 10:11","segments":["Now therefore make confession unto the LORD God of your fathers, and do his pleasure: and separate yourselves from the people of the land, and from the strange wives."],"ref":"Ezra 10:11","verse":11,"words":[{"text":"Now therefore make","strong":"H5414"},{"text":" confession","strong":"H8426"},{"text":" unto the LORD","strong":"H3068"},{"text":" God","strong":"H430"},{"text":" of your fathers","strong":"H1"},{"text":", and do","strong":"H6213"},{"text":" his pleasure","strong":"H7522"},{"text":": and separate","strong":"H914"},{"text":" yourselves from the people","strong":"H5971"},{"text":" of the land","strong":"H776"},{"text":", and from the strange","strong":"H5237"},{"text":"