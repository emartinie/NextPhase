{"book":"Ezra","chapter":10,"entries":[{"id":12253,"title":"Ezra 10:1","segments":["¶Now when Ezra had prayed, and when he had confessed, weeping and casting himself down before the house of God, there assembled unto him out of Israel a very great congregation of men and women and children: for the people wept very sore. {wept...: Heb. wept a great weeping}"],"ref":"Ezra 10:1","verse":1,"words":[{"text":"¶Now when Ezra","strong":"H5830"},{"text":" had prayed","strong":"H6419"},{"text":", and when he had confessed","strong":"H3034"},{"text":", weeping","strong":"H1058"},{"text":" and casting himself down","strong":"H5307"},{"text":" before","strong":"H6440"},{"text":" the house","strong":"H1004"},{"text":" of God","strong":"H430"},{"text":", there assembled","strong":"H6908"},{"text":" unto him out of Israel","strong":"H3478"},{"text":" a very","strong":"H3966"},{"text":" great","strong":"H7227"},{"text":" congregation","strong":"H6951"},{"text":" of men","strong":"H582"},{"text":" and women","strong":"H802"},{"text":" and children","strong":"H3206"},{"text":": for the people","strong":"H5971"},{"text":" wept","strong":"H1058"},{"text":" very","strong":"H7235"},{"text":" sore","strong":"H1059"},{"text":". {wept...: Heb. wept a great weeping}"}]},{"id":12254,"title":"Ezra 10:2","segments":["And Shechaniah the son of Jehiel, [one] of the sons of Elam, answered and said unto Ezra, We have trespassed against our God, and have taken strange wives of the people of the land: yet now there is hope in Israel concerning this thing."],"ref":"Ezra 10:2","verse":2,"words":[{"text":"And Shechaniah","strong":"H7935"},{"text":" the son","strong":"H1121"},{"text":" of Jehiel","strong":"H3171"},{"text":", [one] of the sons","strong":"H1121"},{"text":" of Elam","strong":"H5867"},{"text":", answered","strong":"H6030"},{"text":" and said","strong":"H559"},{"text":" unto Ezra","strong":"H5830"},{"text":", We have trespassed","strong":"H4603"},{"text":" against our God","strong":"H430"},{"