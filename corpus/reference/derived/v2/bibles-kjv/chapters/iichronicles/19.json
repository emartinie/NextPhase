ds":[{"text":"And said","strong":"H559"},{"text":" to the judges","strong":"H8199"},{"text":", Take heed","strong":"H7200"},{"text":" what ye do","strong":"H6213"},{"text":": for ye judge","strong":"H8199"},{"text":" not for man","strong":"H120"},{"text":", but for the LORD","strong":"H3068"},{"text":", who [is] with you in the judgment","strong":"H1697"},{"text":"","strong":"H4941"},{"text":". {in...: Heb. in the matter of judgment}"}]},{"id":11583,"title":"II Chronicles 19:7","segments":["Wherefore now let the fear of the LORD be upon you; take heed and do [it]: for [there is] no iniquity with the LORD our God, nor respect of persons, nor taking of gifts."],"ref":"II Chronicles 19:7","verse":7,"words":[{"text":"Wherefore now let the fear","strong":"H6343"},{"text":" of the LORD","strong":"H3068"},{"text":" be upon you; take heed","strong":"H8104"},{"text":" and do","strong":"H6213"},{"text":" [it]: for [there is] no iniquity","strong":"H5766"},{"text":" with the LORD","strong":"H3068"},{"text":" our God","strong":"H430"},{"text":", nor respect","strong":"H4856"},{"text":" of persons","strong":"H6440"},{"text":", nor taking","strong":"H4727"},{"text":" of gifts","strong":"H7810"},{"text":"."}]},{"id":11584,"title":"II Chronicles 19:8","segments":["Moreover in Jerusalem did Jehoshaphat set of the Levites, and [of] the priests, and of the chief of the fathers of Israel, for the judgment of the LORD, and for controversies, when they returned to Jerusalem."],"ref":"II Chronicles 19:8","verse":8,"words":[{"text":"Moreover in Jerusalem","strong":"H3389"},{"text":" did Jehoshaphat","strong":"H3092"},{"text":" set","strong":"H5975"},{"text":" of the Levites","strong":"H3881"},{"text":", and [of] the priests","strong":"H3548"},{"text":", and of the chief","strong":"H7218"},{"text":" of the fathers","strong":"H1"},{"text":" of Israel","strong":"H3478"},{"text":", for the judgment","strong":"H4941"},{"text":" of the LORD","strong":"H3068"},{"text":", and for controversies","s