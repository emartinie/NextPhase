{"book":"II Chronicles","chapter":18,"entries":[{"id":11543,"title":"II Chronicles 18:1","segments":["¶Now Jehoshaphat had riches and honour in abundance, and joined affinity with Ahab."],"ref":"II Chronicles 18:1","verse":1,"words":[{"text":"¶Now Jehoshaphat","strong":"H3092"},{"text":" had riches","strong":"H6239"},{"text":" and honour","strong":"H3519"},{"text":" in abundance","strong":"H7230"},{"text":", and joined affinity","strong":"H2859"},{"text":" with Ahab","strong":"H256"},{"text":"."}]},{"id":11544,"title":"II Chronicles 18:2","segments":["And after [certain] years he went down to Ahab to Samaria. And Ahab killed sheep and oxen for him in abundance, and for the people that [he had] with him, and persuaded him to go up [with him] to Ramothgilead. {after...: Heb. at the end of years}"],"ref":"II Chronicles 18:2","verse":2,"words":[{"text":"And after","strong":"H7093"},{"text":" [certain] years","strong":"H8141"},{"text":" he went down","strong":"H3381"},{"text":" to Ahab","strong":"H256"},{"text":" to Samaria","strong":"H8111"},{"text":". And Ahab","strong":"H256"},{"text":" killed","strong":"H2076"},{"text":" sheep","strong":"H6629"},{"text":" and oxen","strong":"H1241"},{"text":" for him in abundance","strong":"H7230"},{"text":", and for the people","strong":"H5971"},{"text":" that [he had] with him, and persuaded","strong":"H5496"},{"text":" him to go up","strong":"H5927"},{"text":" [with him] to Ramothgilead","strong":"H7433"},{"text":"","strong":"H1568"},{"text":". {after...: Heb. at the end of years}"}]},{"id":11545,"title":"II Chronicles 18:3","segments":["And Ahab king of Israel said unto Jehoshaphat king of Judah, Wilt thou go with me to Ramothgilead? And he answered him, I [am] as thou [art], and my people as thy people; and [we will be] with thee in the war."],"ref":"II Chronicles 18:3","verse":3,"words":[{"text":"And Ahab","strong":"H256"},{"text":" king","strong":"H4428"},{"text":" of Israel","strong":"H3478"},{"text":" said","strong":"H559"},