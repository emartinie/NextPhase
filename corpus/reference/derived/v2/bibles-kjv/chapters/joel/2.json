":"H2428"},{"text":": for his camp","strong":"H4264"},{"text":" [is] very","strong":"H3966"},{"text":" great","strong":"H7227"},{"text":": for [he is] strong","strong":"H6099"},{"text":" that executeth","strong":"H6213"},{"text":" his word","strong":"H1697"},{"text":": for the day","strong":"H3117"},{"text":" of the LORD","strong":"H3068"},{"text":" [is] great","strong":"H1419"},{"text":" and very","strong":"H3966"},{"text":" terrible","strong":"H3372"},{"text":"; and who can abide","strong":"H3557"},{"text":" it?"}]},{"id":22323,"title":"Joel 2:12","segments":["¶Therefore also now, saith the LORD, turn ye [even] to me with all your heart, and with fasting, and with weeping, and with mourning:"],"ref":"Joel 2:12","verse":12,"words":[{"text":"¶Therefore also now, saith","strong":"H5002"},{"text":" the LORD","strong":"H3068"},{"text":", turn","strong":"H7725"},{"text":" ye [even] to me with all your heart","strong":"H3824"},{"text":", and with fasting","strong":"H6685"},{"text":", and with weeping","strong":"H1065"},{"text":", and with mourning","strong":"H4553"},{"text":":"}]},{"id":22324,"title":"Joel 2:13","segments":["And rend your heart, and not your garments, and turn unto the LORD your God: for he [is] gracious and merciful, slow to anger, and of great kindness, and repenteth him of the evil."],"ref":"Joel 2:13","verse":13,"words":[{"text":"And rend","strong":"H7167"},{"text":" your heart","strong":"H3824"},{"text":", and not your garments","strong":"H899"},{"text":", and turn","strong":"H7725"},{"text":" unto the LORD","strong":"H3068"},{"text":" your God","strong":"H430"},{"text":": for he [is] gracious","strong":"H2587"},{"text":" and merciful","strong":"H7349"},{"text":", slow","strong":"H750"},{"text":" to anger","strong":"H639"},{"text":", and of great","strong":"H7227"},{"text":" kindness","strong":"H2617"},{"text":", and repenteth","strong":"H5162"},{"text":" him of the evil","strong":"H7451"},{"text":"."}]},{"id":22325,"title":"Joel 2:14","segments":["