i; an hour; eye; fountain"]},{"id":154,"title":"Aijeleth-Shahar","segments":["the land of the morning"]},{"id":155,"title":"Ain","segments":["same as Aiath"]},{"id":156,"title":"Ajalon","segments":["a chain; strength; a stag"]},{"id":157,"title":"Akkub","segments":["foot-print; supplanting; crookedness; lewdness"]},{"id":158,"title":"Akrabbim","segments":["scorpions"]},{"id":159,"title":"Alammelech","segments":["God is king"]},{"id":160,"title":"Alemeth","segments":["hiding; youth; worlds; upon the dead"]},{"id":161,"title":"Alexander","segments":["one who assists men"]},{"id":162,"title":"Alian","segments":["high"]},{"id":163,"title":"Alleluia","segments":["praise the Lord"]},{"id":164,"title":"Allon","segments":["an oak; strong"]},{"id":165,"title":"Allon-bachuth","segments":["the oak of weeping"]},{"id":166,"title":"Almodad","segments":["measure of God"]},{"id":167,"title":"Almon","segments":["hidden"]},{"id":168,"title":"Almon-diblathaim","segments":["hidden in a cluster of fig trees"]},{"id":169,"title":"Alpheus","segments":["a thousand; learned; chief"]},{"id":170,"title":"Alush","segments":["mingling together"]},{"id":171,"title":"Alvah","segments":["his rising up; his highness"]},{"id":172,"title":"Amad","segments":["people of witness; a prey"]},{"id":173,"title":"Amal","segments":["labor; iniquity"]},{"id":174,"title":"Amalek","segments":["a people that licks up"]},{"id":175,"title":"Aman","segments":["mother; fear of them"]},{"id":176,"title":"Amana","segments":["integrity; truth; a nurse"]},{"id":177,"title":"Amariah","segments":["the Lord says; the integrity of the Lord"]},{"id":178,"title":"Amasa","segments":["sparing the people"]},{"id":179,"title":"Amasai","segments":["strong"]},{"id":180,"title":"Amashai","segments":["the people's gift"]},{"id":181,"title":"Amashi-ali","segments":["same as Amaziah"]},{"id":182,"title":"Ami","segments":["mother; fear; people"]},{"id":183,"title":"Amaziah","segments":["the strength of the Lord"]},{"id":184,"title":"Ami